# Caddy — التوجيه على السيرفر
#
# الفكرة كلها في حاجتين:
#
#   ١. الموقع والـ API ورا نفس الدومين. ده مش تفضيل — الكوكيز بتستخدم بادئة
#      `__Host-` اللي بتشترط أصل واحد، ومفيش CORS متظبط في أي مكان في المشروع.
#
#   ٢. الملفات المرفوعة على دومين **تاني**. الـ API بيرفض يشتغل من أصله لو
#      `MEDIA_BASE_URL` طلع نفس أصل `APP_URL` (شوف `apps/api/src/config/env.ts`)
#      — لأن ملف HTML مرفوع على نفس الأصل بيبقى XSS مهما كانت الـ CSP.

aymanaboelela.com, www.aymanaboelela.com {
	encode zstd gzip

	# الـ API الأول: Caddy بيطابق بالأطول، فالقاعدة دي بتسبق `/` تحتها.
	#
	# بيروح لـ 3300 مباشرة، مش عن طريق الـ rewrite بتاع Next. Next عنده
	# rewrite لـ `/api/:path*` وده اللي بيشتغل في التطوير المحلي؛ في
	# الإنتاج توجيهه من هنا بيوفّر قفزة زيادة على كل طلب.
	handle /api/* {
		reverse_proxy 127.0.0.1:3300
	}

	# ⚠️ `/media/*` **مش** هنا عن قصد. الملفات ليها دومينها تحت.
	# لو ضفتها هنا، الـ API هيرفض يقلع.

	handle {
		reverse_proxy 127.0.0.1:3200
	}

	header {
		# Caddy بيحط HSTS لوحده مع الشهادة، بس بنكتبه صريح عشان يشمل
		# الساب دومينات وميعتمدش على الافتراضي.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

# دومين الملفات المرفوعة.
media.aymanaboelela.com {
	encode zstd gzip

	# نفس العملية (NestJS على 3300) بس **مسار واحد بس** مكشوف.
	#
	# ده مهم: العملية دي شايلة الـ API كله. لو عملنا proxy لكل حاجة هنا،
	# دومين الملفات هيبقى نسخة تانية من الـ API على أصل مالوش نفس الحماية.
	# أي حاجة غير `/media/*` بتترد 404.
	handle /media/* {
		reverse_proxy 127.0.0.1:3300
	}

	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
