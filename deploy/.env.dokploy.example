# متغيرات Dokploy — انسخها في تبويب Environment بتاع الـ Compose.
# مفيش ملف .env بيتراكب في git، والصورة عمرها ما بتشيل أسرار.

# ── الدومينات ─────────────────────────────────────────────────────────
APP_DOMAIN="aymanaboelela.com"
APP_URL="https://aymanaboelela.com"

# ⚠️ لازم دومين مختلف عن APP_DOMAIN. الـ API بيرفض يقلع لو الأصلين اتساووا،
# لأن ملف HTML مرفوع على نفس أصل التطبيق بيبقى XSS مهما كانت الـ CSP.
MEDIA_DOMAIN="media.aymanaboelela.com"
MEDIA_ORIGIN="https://media.aymanaboelela.com"

# ── أسرار ─────────────────────────────────────────────────────────────
# openssl rand -base64 32
POSTGRES_PASSWORD="CHANGE_ME"
RUNTIME_PASSWORD="CHANGE_ME"

# openssl rand -base64 48   (٣٢ حرف على الأقل — تغييره بيلغّي كل الجلسات)
BETTER_AUTH_SECRET="CHANGE_ME"

# ── "كمّل بحساب جوجل" ─────────────────────────────────────────────────
# من Google Cloud Console ← APIs & Services ← Credentials
# ← Create credentials ← OAuth client ID ← نوع Web application.
#
# ⚠️ في نفس الشاشة، خانة "Authorized redirect URIs" لازم تحتوي بالظبط على
# السطر ده (هو APP_URL فوق + /api/auth/callback/google):
#
#     https://aymanaboelela.com/api/auth/callback/google
#
# الاتنين مع بعض أو ولا واحد — لو حطيت واحد بس الـ API هيرفض يقلع.
# سيبهم فاضيين والزرار هيفضل ظاهر بس هيرجّع خطأ.
#
# الشرح كامل: docs/runbooks/google-sign-in.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── اختياري ───────────────────────────────────────────────────────────
# سيبها فاضية أول أسبوع. الـ CSP بتفضل مراقبة بس وبتبعت تقارير على
# /api/security/csp-report — تابعها، وبعدين حطها "1".
CSP_ENFORCE=""
