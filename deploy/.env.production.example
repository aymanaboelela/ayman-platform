# قالب متغيرات الإنتاج — انسخه لـ /srv/ayman/.env وغيّر كل قيمة فيها CHANGE_ME
#
# السيرفر بيرفض يقلع لو أي متغيّر مطلوب ناقص أو شكله غلط، وبيطبع كل
# الغلطات مرة واحدة (`apps/api/src/config/env.ts`). ده مقصود.
#
# صلاحيات الملف: chmod 600، ومملوك لليوزر اللي بيشغّل الخدمة.

# ── الداتابيز ─────────────────────────────────────────────────────────
# دورين مختلفين عن قصد. `ayman_runtime` بيقرا ويكتب بس ومش قادر يعدّل
# بنية الجداول — ده الضابط اللي بيمنع أي ثغرة SQL من إنها تعمل جدول أو
# دالة. `ayman_owner` للميجريشن بس والسيرفر الشغال عمره ما بيستخدمه.
DATABASE_URL="postgresql://ayman_runtime:CHANGE_ME@127.0.0.1:5432/ayman_platform?schema=app"
DIRECT_DATABASE_URL="postgresql://ayman_owner:CHANGE_ME@127.0.0.1:5432/ayman_platform?schema=app"

# ── التطبيق ───────────────────────────────────────────────────────────
NODE_ENV="production"
API_PORT="3300"
APP_URL="https://aymanaboelela.com"

# ── Redis ─────────────────────────────────────────────────────────────
# مش اختياري. حدود الطلبات متخزّنة هنا — لو شغّلت أكتر من نسخة من الـ API
# من غيره، كل نسخة هيبقى عندها عدّاد لوحدها والحد الفعلي بيتضاعف.
REDIS_URL="redis://127.0.0.1:6379"

# ── Better Auth ───────────────────────────────────────────────────────
# ولّده بـ:  openssl rand -base64 48
# ٣٢ حرف على الأقل. تغييره بيلغّي كل الجلسات المفتوحة.
BETTER_AUTH_SECRET="CHANGE_ME_openssl_rand_base64_48"
BETTER_AUTH_URL="https://aymanaboelela.com"

# ── "كمّل بحساب جوجل" ─────────────────────────────────────────────────
# من Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (نوع: Web application). سيبهم فاضيين والزرار هيفضل موجود بس هيرجّع خطأ.
#
# في نفس الشاشة، لازم "Authorized redirect URIs" تحتوي بالظبط على:
#   https://aymanaboelela.com/api/auth/callback/google
# (ده APP_URL + /api/auth/callback/google — Next بيمرّر /api/* للـ API)
#
# الشرح بالتفصيل: docs/runbooks/google-sign-in.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── الملفات المرفوعة ──────────────────────────────────────────────────
# ⚠️ لازم يبقى أصل **مختلف** عن APP_URL — الـ API بيتأكد من ده عند الإقلاع
# ويرفض يشتغل لو اتساووا. السبب: ملف مرفوع على نفس الأصل = XSS على نفس
# الأصل، مهما كانت الـ CSP.
#
# لاحظ الـ `/media` في آخره: ده الجزء الأساسي اللي المفاتيح بتتركّب عليه،
# فالرابط النهائي بيبقى https://media.aymanaboelela.com/media/ab/xxx.webp
MEDIA_BASE_URL="https://media.aymanaboelela.com/media"

# القرص. لازم يكون قابل للكتابة من يوزر الخدمة، وداخل في النسخ الاحتياطي.
MEDIA_ROOT="/var/lib/ayman/media"

# حد رفع الصور. ٨ ميجا افتراضيًا.
MEDIA_MAX_BYTES="8388608"

# ── الويب (Next.js) ───────────────────────────────────────────────────
# داخلي — الويب بيكلّم الـ API على نفس الجهاز، مش بيخرج للإنترنت ويرجع.
API_ORIGIN="http://127.0.0.1:3300"
NEXT_PUBLIC_APP_URL="https://aymanaboelela.com"
NEXT_PUBLIC_MEDIA_ORIGIN="https://media.aymanaboelela.com"

# الـ CSP مراقبة بس في الأول. سيبها فاضية، وبعد ما تتابع تقارير المخالفات
# على /api/security/csp-report لمدة أسبوع، حطها "1" عشان تتفعّل.
# شوف runbooks/launch-runbook.md
CSP_ENFORCE=""

# ── جوجل (اختياري) ────────────────────────────────────────────────────
# الاتنين مع بعض أو ولا واحد — الـ API بيرفض واحد من غير التاني.
# الـ redirect URI: https://aymanaboelela.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── آبل (اختياري) ─────────────────────────────────────────────────────
# الأربعة مع بعض أو ولا واحد.
# ⚠️ APPLE_PRIVATE_KEY ده مش مفتاح ثابت — الـ client_secret بتاع آبل JWT
# بينتهي كل ٦ شهور كحد أقصى. يعني تسجيل الدخول بآبل هيقف فجأة بعد ٦ شهور
# من غير ما يتغيّر كود ومن غير رسالة واضحة. حط تذكير كل ٥ شهور.
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""

# ── بذرة حساب الأدمن (للتشغيل مرة واحدة) ──────────────────────────────
# `pnpm --filter @ayman/api exec tsx prisma/seed-admin.ts` بيقراهم.
# امسحهم من الملف بعد ما تشغّله.
E2E_ADMIN_EMAIL="CHANGE_ME@aymanaboelela.com"
E2E_ADMIN_PASSWORD="CHANGE_ME_a_long_random_password"
