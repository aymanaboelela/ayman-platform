# ── قالب ستاك مدرّس جديد ──────────────────────────────────────────────
#
# انسخ ده في تبويب Environment بتاع تطبيق Dokploy الجديد، وغيّر **كل** قيمة
# مكتوب جنبها CHANGE_ME. الخطوات بالترتيب في `docs/runbooks/new-tenant.md`.
#
# ⚠️ الملف ده مالوش أي علاقة بستاك أيمن. ستاك أيمن مابيحطش ولا واحد من
# متغيرات `TENANT_*` دي، وسايبها فاضية هو اللي بيخلّيه يشتغل بالقيم القديمة
# بالحرف. متضيفهاش عنده.


# ═══ ١. هوية الستاك — المفتاح اللي بيمنع تسريب هوية أيمن ══════════════
#
# لازم يكون حاجة **غير** `ayman` وغير فاضي. القيمة دي هي اللي بتقول للكود
# «الستاك ده مش بتاع أيمن»، وساعتها مافيش حاجة بتتورّث: مافيش رقم واتساب،
# ولا حسابات سوشيال، ولا صفحة هبوط، ولا اسم جهاز.
#
# حروف صغيرة وأرقام وشرطة بس — بيدخل في أسماء وسجلات.
TENANT_KEY=CHANGE_ME              # مثال: mohamed-hassan

# الاسم اللي بيتكتب في الهيرو قبل ما المدرّس يركّب صفحته من /admin/home،
# وكمان وقت أي عطل في الـAPI بعد كده. لو سبته فاضي هيكتب «المنصة التعليمية»
# — يعني مش هيسمّي حد غلط، بس كمان مش هيسمّيه هو.
TENANT_DISPLAY_NAME=CHANGE_ME     # مثال: منصة محمد حسن


# ═══ ٢. الداتابيز ══════════════════════════════════════════════════════
#
# اسم مختلف لكل ستاك. لو اتساب زي بتاع حد تاني على نفس السيرفر، الاتنين
# هيكتبوا في نفس الداتابيز — ودي الكارثة اللي التقسيم ده كله عشانها.
POSTGRES_DB=CHANGE_ME             # مثال: x_platform

# اتنين مختلفين، ولكل ستاك بتوعه هو. ولّدهم بـ:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
RUNTIME_PASSWORD=CHANGE_ME


# ═══ ٣. الدومينات ══════════════════════════════════════════════════════
#
# ⚠️ دومين أساسي (apex) مستقل، **مش** ساب-دومين تحت دومين أيمن. سببين:
# الـHSTS بيتبعت بـ`includeSubDomains; preload`، وشهادة Cloudflare المجانية
# بتغطي مستوى واحد بس — يعني `media.x.aymanaboelela.com` مالهاش شهادة أصلًا.
#
# والموقع والـAPI **لازم** يكونوا على نفس الأصل (`x.com` و`x.com/api/*`)،
# مش دومينين. الكوكيز بتستخدم بادئة `__Host-` ومفيش CORS متظبط في أي مكان
# عن قصد — التقسيم ده قرار معماري مش إعداد (docs/DEPLOYMENT.md §١).
APP_URL=CHANGE_ME                 # مثال: https://mohamedhassan.com

# ⚠️ لازم يكون أصل **مختلف** عن APP_URL — الـAPI بيرفض يقوم غير كده
# (apps/api/src/config/env.ts). دومين تاني أو ساب-دومين لدومينه هو.
MEDIA_ORIGIN=CHANGE_ME            # مثال: https://media-mohamedhassan.com


# ═══ ٤. الأسرار ════════════════════════════════════════════════════════
#
# ⚠️ جديد لكل ستاك، من غير أي إعادة استخدام. لو اتنين اتشاركوا نفس
# `BETTER_AUTH_SECRET` يبقى توكن جلسة من منصة يشتغل على التانية.
#   openssl rand -base64 48
BETTER_AUTH_SECRET=CHANGE_ME

# أول أدمن. الباسورد ده بيتغيّر من جوه المنصة أول ما يدخل.
ADMIN_NAME=CHANGE_ME
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# مفاتيح Web Push. جوز جديد لكل ستاك:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=CHANGE_ME           # mailto:… بتاع المدرّس ده


# ═══ ٥. الواتساب ═══════════════════════════════════════════════════════
#
# رقم وجهاز لكل مدرّس. الرسايل بتروح باسمه هو.
WA_TOKEN=CHANGE_ME                # openssl rand -hex 32

# الاسم اللي بيبان في «الأجهزة المرتبطة» على تليفونه. سيبه فاضي وهياخد
# `<TENANT_KEY> Platform` — شغّال بس وحش. اكتبه.
WA_DEVICE_NAME=CHANGE_ME          # مثال: منصة محمد حسن


# ═══ ٦. حسابات المدرّس — سيب أي واحد فاضي لو لسه مش موجود ═════════════
#
# فاضي = اللينك ده مايترسمش خالص. ودي النتيجة الصح: لينك ناقص أحسن من لينك
# شغّال بيوصّل لحد تاني. اللي يتكتب هنا بيتزرع في `site_settings` أول إقلاع،
# وبعد كده المدرّس بيعدّله من /admin/settings وده اللي بيفضل.
TENANT_YOUTUBE=
TENANT_INSTAGRAM=
TENANT_TIKTOK=
TENANT_FACEBOOK=
TENANT_WHATSAPP_CHANNEL=
TENANT_WHATSAPP=                  # بصيغة E.164، مثال: +201000000000


# ═══ ٧. اختيارية ═══════════════════════════════════════════════════════
#
# ⚠️ لو سبته من غير ما تكتبه خالص، الستاك بتاع المدرّس ده هيبعت جلسات
# زواره على مشروع Clarity بتاع أيمن. اكتب مشروعه هو، أو خليه `=` فاضية
# عشان يتقفل.
CLARITY_PROJECT_ID=

# مرآة الفيديو على R2. باكِت لكل مدرّس، ومفتاح مقصور عليه.
VIDEO_ORIGIN=
VIDEO_MIRROR_ENDPOINT=
VIDEO_MIRROR_BUCKET=
VIDEO_MIRROR_ACCESS_KEY_ID=
VIDEO_MIRROR_SECRET_ACCESS_KEY=

# مفاتيح الذكاء الاصطناعي. ينفع تتشارك، بس ساعتها الاستهلاك بيتحاسب عليك.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# جوجل. سيبهم فاضيين والزرار مايترسمش أصلًا والتسجيل بالموبايل بيشتغل عادي —
# ودي بقت مضمونة بالكود مش كلام: `NEXT_PUBLIC_GOOGLE_ENABLED` في الكومبوز
# متولّد من `${GOOGLE_CLIENT_ID:+1}`، يعني بيتحط بس لو ده متظبط.
#
# ⚠️ قبل كده الزرار كان بيترسم دايمًا حتى من غير مفاتيح، والطالب يدوس
# ويلاقيه مكسور — والـAPI طول الوقت بيتصرف صح، وده اللي كان بيخلّيه صعب
# يتلاقى. مكانش بيبان عند أيمن لأن مفاتيحه متظبطة.
#
# لو هتستخدم عميل جوجل، ضيف `<APP_URL>/api/auth/callback/google` في الـ
# redirect URIs بتاعته.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

INSTAPAY_INGEST_TOKEN=
CSP_ENFORCE=
