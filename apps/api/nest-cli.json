{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "ignore": [
          "**/*.spec.ts"
        ]
      }
    },
    "assets": [
      {
        "include": "scripts/seed-data/**/*.webp",
        "outDir": "dist"
      }
    ]
  }
}
