# ── database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ayman_runtime:CHANGE_ME@localhost:5432/ayman_platform_dev?schema=app"
# migrations only; has DDL rights. Never used by the running server.
DIRECT_DATABASE_URL="postgresql://ayman_owner:CHANGE_ME@localhost:5432/ayman_platform_dev?schema=app"

# ── app ───────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT="3300"
APP_URL="http://localhost:3200"

# ── redis (throttler + cache handler) ─────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── better auth ───────────────────────────────────────────────────────
# 32+ chars. Generate one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="CHANGE_ME_32_CHARS_MINIMUM_______"
BETTER_AUTH_URL="http://localhost:3300"

# ── "المتابعة بحساب جوجل" (Google sign-in) ─────────────────────────────────
# Optional — the app boots without these, and the button 400s until they're
# set. Both are required together; a lone id or secret fails env validation.
# Get them from the Google Cloud console and register the redirect URI that
# matches THIS file's BETTER_AUTH_URL:
#   local  -> http://localhost:3300/api/auth/callback/google
#   prod   -> https://<your-domain>/api/auth/callback/google
# Full walkthrough: docs/runbooks/google-sign-in.md
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Apple is scaffolded API-side but has no button in the UI, and cannot be
# driven from http://localhost at all (Apple rejects those redirect URIs).
# All four are required together, or all omitted.
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""

# ── media ─────────────────────────────────────────────────────────────
# A DIFFERENT origin from the app: a same-origin HTML upload is same-origin
# XSS regardless of CSP (A10). In this deployment media is served by THIS
# SAME process on API_PORT (GET /media/:prefix/:name, excluded from the
# /api prefix) — the origin here differs from APP_URL only by PORT (3300 vs
# 3200), which still satisfies the browser's same-origin policy. Before
# launch, move this to a distinct hostname (see Task 13's report note: a
# shared registrable domain does not isolate cookies the way a distinct
# domain does).
#
# `apps/web`'s NEXT_PUBLIC_MEDIA_ORIGIN must be set to this SAME origin —
# env.ts asserts at boot that this is not the SAME origin as APP_URL, but it
# cannot see the web app's own env (two independently deployed processes),
# so keeping these two in sync across apps is still an operator's job.
MEDIA_BASE_URL="http://localhost:3300/media"
# Where uploaded, re-encoded bytes live on disk.
MEDIA_ROOT="./.media"
# 8 MiB — mirrors MAX_UPLOAD_BYTES in @ayman/contracts/admin/media.
MEDIA_MAX_BYTES="8388608"
