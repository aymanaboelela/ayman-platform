// Prisma 7: the `prisma-client` generator (not `prisma-client-js`) emits ESM by
// default, which breaks a CommonJS Nest build — hence moduleFormat = "cjs".
// The output MUST live inside src/ or Nest's compiler will not pick it up.
//
// Prisma 7 also dropped `url`/`directUrl` from the datasource block entirely —
// connection strings now live in prisma.config.ts (for the CLI/migrate) and are
// passed to `new PrismaClient({ adapter })` at runtime (see prisma.service.ts).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ── Better Auth ──────────────────────────────────────────────────────────
// Field/table names below are verified against Better Auth's own Prisma CLI
// generator output (packages/cli/test/__snapshots__/schema.prisma, checked
// via context7 against better-auth@1.6.x). `@map`/`@@map` only rename the
// underlying SQL identifiers — the Prisma model names (User, Session,
// Account, Verification) and their camelCase fields are exactly what
// Better Auth's Prisma adapter expects to find on the generated client, so
// don't rename those without re-checking the adapter's `getModelName`.

/// `role` drives authorization (Task 2's `RequirePermission` guard checks a
/// role→permission map, never role equality). Registered in `auth.config.ts`
/// as a Better Auth `additionalFields` entry with `input: false` so it is
/// never settable through sign-up/update-user payloads — the only writers are
/// server-side (default on insert, or a future admin-only endpoint).
model User {
  id            String   @id
  name          String
  /// NULL when the student never gave one. Genuinely optional — there are no
  /// synthesised `…@phone.invalid` placeholders in this column any more, and
  /// the migration that made it nullable converted the ones that existed.
  ///
  /// Better Auth's core table declares `email` as `required: true`
  /// (`@better-auth/core/db/get-tables.mjs`), so this needs TWO things to hold
  /// together, and removing either one breaks sign-up:
  ///
  ///   · `user.additionalFields.email` in `auth.config.ts` re-declares the
  ///     field as `required: false`. `getAuthTables` spreads
  ///     `options.user.additionalFields` AFTER its own block, so the override
  ///     wins; without it `parseInputData` throws `MISSING_FIELD` on any
  ///     sign-up that omits an address.
  ///   · `/sign-up/email` ALSO validates the body with `z.email()` before any
  ///     of that runs, and no option disables it. `createAuthBeforeHook` fills
  ///     in a throwaway address to satisfy that one check and
  ///     `databaseHooks.user.create.before` strips it again, so the value
  ///     exists only inside the request and is never written here.
  ///
  /// `@unique` still applies. Postgres exempts NULLs from a unique index,
  /// which is exactly right: every email-less account is NULL and they must
  /// not collide with each other, while two accounts still cannot share a real
  /// address. Uniqueness for those accounts is carried by `phoneNumber`.
  email         String?
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          String   @default("student")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// ── Phone as the primary sign-up identifier ──────────────────────────
  ///
  /// Column name and type are dictated by Better Auth's `phoneNumber` plugin
  /// (`better-auth/dist/plugins/phone-number/schema.mjs`), which declares
  /// `phoneNumber` / `phoneNumberVerified` on the USER model and offers only a
  /// rename — the fields cannot be pointed at `student_profiles`. That is why
  /// this lives here and not next to `StudentProfile.phone`.
  ///
  /// Nullable for exactly two populations, and nothing else:
  ///   · accounts that predate this column and never finished onboarding, so
  ///     there was no number anywhere to backfill from;
  ///   · a Google sign-up, between the OAuth callback creating the row and the
  ///     student reaching onboarding step 1. Nothing in an OAuth flow can be
  ///     made to demand a phone, so the account genuinely exists without one
  ///     for that window. `apps/web/proxy.ts` is what makes it unusable until
  ///     the number is given.
  ///
  /// Always E.164 (`+201012345678`). This is not cosmetic: Better Auth looks
  /// the account up with an EXACT STRING match and its `phoneNumberValidator`
  /// cannot rewrite what it is handed, so an un-normalised row is an account
  /// its owner can never sign in to. `createPhoneNormalizationHook` in
  /// `auth.config.ts` is the choke point that guarantees the form.
  ///
  /// Plain text, not citext, deliberately — the plugin's own `findOne` is a
  /// byte comparison, so a case-insensitive column would let the DATABASE
  /// consider two rows equal that the LIBRARY considers different. E.164 has
  /// no letters, so citext would buy nothing anyway.
  phoneNumber         String?  @unique @map("phone_number")
  /// Written only by the phone-number plugin's OTP path, which is not wired up
  /// yet — `sendOTP` currently refuses (`auth.config.ts`), so this is `false`
  /// on every row today. It exists now so that turning OTP on later is a
  /// config change rather than another migration against a live users table.
  phoneNumberVerified Boolean? @default(false) @map("phone_number_verified")

  /// ── Ban (حظر) ────────────────────────────────────────────────────────
  ///
  /// Nullable timestamp rather than a boolean, for the reason every other
  /// state column here is: `bannedAt` answers "since when", which is the
  /// question support actually gets asked, and a boolean cannot be widened
  /// into it later without a backfill that has no data to draw on.
  ///
  /// The ban is enforced in TWO places and needs both:
  ///   · `databaseHooks.session.create.before` refuses to mint a new session,
  ///     which covers email/password, sign-up and Google in one place;
  ///   · `StudentsService.ban` deletes every existing session row, because the
  ///     hook only runs on creation and a student already signed in would
  ///     otherwise keep their 90-day session.
  /// `session.cookieCache` is deliberately absent (see `auth.config.ts`), so
  /// deleting the rows takes effect on the very next request rather than
  /// whenever a cached cookie happens to expire.
  bannedAt       DateTime? @map("banned_at")
  /// Shown to the student on the sign-in screen. Nullable because a ban with
  /// no stated reason is still a valid ban; the UI falls back to generic copy.
  bannedReason   String?   @map("banned_reason")
  /// `SetNull`, not `Cascade`: deleting the admin who issued a ban must not
  /// silently unban the student. The ban survives its issuer.
  bannedByUserId String?   @map("banned_by_user_id")
  bannedBy       User?     @relation("UserBannedBy", fields: [bannedByUserId], references: [id], onDelete: SetNull)
  bansIssued     User[]    @relation("UserBannedBy")

  sessions       Session[]
  accounts       Account[]
  studentProfile StudentProfile?
  sessionDevices SessionDevice[]
  courses        Course[]
  enrollments    Enrollment[]
  accessGrants   AccessGrant[]   @relation("AccessGrantSubject")
  grantsIssued   AccessGrant[]   @relation("AccessGrantIssuer")

  // Plan 5 — question bank
  questionBankEntries QuestionBankEntry[]
  questionVersions    QuestionVersion[]
  // Plan 5 — attempts
  quizAttempts        QuizAttempt[]
  gradedQuestions     AttemptQuestion[] @relation("AttemptQuestionGrader")
  // Slice 4 — in-app notifications.
  notifications       Notification[]
  // Web Push — one row per subscribed browser. `Cascade`: a subscription is
  // meaningless without the account it wakes up.
  pushSubscriptions   PushSubscription[]
  // المساعد — threads this student opened. `onDelete: SetNull` on the far
  // side, so deleting the account orphans the thread rather than erasing it.
  conversations       Conversation[]
  // «رسايل م. أيمن» — what the platform sent this student in his name.
  // `Cascade`, unlike `conversations` above: this table's whole purpose is
  // "which wording has this person already had", and that question dies with
  // the person. The MESSAGE itself lives on the conversation, which survives.
  outreachMessages    OutreachMessage[]
  // المساعد's open chat — what this student typed into it. `SetNull` on the far
  // side, like `conversations`: deleting the account must not erase the
  // QUESTION, because the question is what the corpus gets written from and it
  // is useful long after the person who asked it has gone.
  assistantQuestions  AssistantQuestion[]
  newsPosts           NewsPost[]
  // التسويق — campaigns this admin wrote, and campaign messages this student
  // was queued for. Both `SetNull` on the far side: a deleted account must not
  // take the record of what went out with it, because that record is the only
  // answer to «مين اتبعتله».
  marketingCampaigns  MarketingCampaign[]  @relation("MarketingCampaignAuthor")
  marketingMessages   MarketingRecipient[] @relation("MarketingRecipientUser")
  // Vodafone Cash payment claims — this student's own, and (for an admin)
  // the ones they reviewed. `SetNull` on the reviewer side only: a rejected
  // or approved submission is the record of what a STUDENT claimed, which
  // must survive the reviewing admin's account being deleted.
  paymentSubmissions         PaymentSubmission[] @relation("PaymentSubmissionStudent")
  paymentSubmissionsReviewed PaymentSubmission[] @relation("PaymentSubmissionReviewer")
  // الكتاب الورقي — this student's own orders, and (for an admin) the ones
  // they marked shipped. `SetNull` on the shipper side only, same reasoning
  // as `paymentSubmissionsReviewed`: the order is the record of what a
  // STUDENT asked for, which must survive the shipping admin's account
  // being deleted.
  bookOrders          BookOrder[] @relation("BookOrderStudent")
  bookOrdersShipped   BookOrder[] @relation("BookOrderShippedBy")
  bookOrdersDelivered BookOrder[] @relation("BookOrderDeliveredBy")
  bookOrdersRejected  BookOrder[] @relation("BookOrderRejectedBy")
  bookOrdersDeleted   BookOrder[] @relation("BookOrderDeletedBy")

  @@unique([email])
  /// Ledger rows this account entered — see `Expense.createdBy`.
  expensesCreated Expense[]

  @@map("users")
  @@schema("app")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
  @@schema("app")
}

/// S6: accounts are keyed on (providerId, accountId) — the provider's own
/// user id — never on email, which is mutable and would otherwise be an
/// account-takeover primitive. The extra unique index below enforces that
/// at the database level, on top of whatever Better Auth checks in-process.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
  @@schema("app")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
  @@schema("app")
}

/// §6.7 / Task 7. Our own table, not Better Auth's — one row per Better Auth
/// `Session`, created in `databaseHooks.session.create.after`
/// (`auth.config.ts`) from the user agent Better Auth already captured on
/// that session row. `sessionId` is deliberately a PLAIN indexed column, not
/// a Prisma `@relation` to `Session`: revoking a device deletes the
/// underlying `Session` row directly (so the next request using that
/// session's cookie is genuinely rejected by `AuthGuard`, not merely hidden
/// from a list) while this row survives with `revokedAt` set — a hard FK
/// with `onDelete: Cascade` would delete the audit trail in the same
/// statement; `onDelete: SetNull` would require a nullable column for no
/// benefit, since nothing here needs relational integrity against a table
/// Better Auth, not us, owns the lifecycle of.
model SessionDevice {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id")
  sessionId  String    @unique @map("session_id")
  deviceName String    @map("device_name")
  deviceType String    @map("device_type")
  ip         String?   @db.Inet
  lastSeenAt DateTime  @map("last_seen_at")
  loggedInAt DateTime  @default(now()) @map("logged_in_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The IDOR-critical index: every ownership-scoped query (list, revoke)
  // filters on exactly this pair, compiled into the WHERE clause itself.
  @@index([userId, revokedAt])
  @@map("session_devices")
  @@schema("app")
}

enum Region {
  urban
  lower
  upper
  frontier

  @@schema("app")
}

enum SubjectLevel {
  normal
  advanced

  @@schema("app")
}

enum Gender {
  male
  female

  @@schema("app")
}

/// Which school a STUDENT goes to — مدرسة عام ولا مدرسة لغات.
///
/// Deliberately two values, not the three a course gets. `courses`/`lessons`
/// carry `for_general` + `for_languages` because one course can serve both
/// audiences; a student attends exactly one school, so «الاتنين» is not a
/// state they can be in. Same vocabulary, different arity, on purpose.
enum SchoolStream {
  general
  languages

  @@schema("app")
}

/// The 27 Egyptian governorates, keyed by their official national-ID code.
model Governorate {
  code      String  @id @db.Char(2)
  nameAr    String  @map("name_ar")
  slug      String  @unique
  region    Region
  sortOrder Int     @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  studentProfiles StudentProfile[]
  bookOrders      BookOrder[]

  @@map("governorates")
  @@schema("app")
}

/// البكالوريا (600 marks, 70% pass) and الثانوية العامة (320 marks, 50% pass)
/// run in PARALLEL — one is not a replacement for the other.
model EducationSystem {
  id            String  @id @default(uuid(7)) @db.Uuid
  slug          String  @unique
  nameAr        String  @map("name_ar")
  totalMarks    Int     @map("total_marks")
  passPercent   Decimal @map("pass_percent") @db.Decimal(5, 2)
  allowsRetakes Boolean @default(false) @map("allows_retakes")
  sortOrder     Int     @map("sort_order")

  years           AcademicYear[]
  tracks          Track[]
  offerings       SubjectOffering[]
  studentProfiles StudentProfile[]
  courses         Course[]

  @@map("education_systems")
  @@schema("app")
}

/// The Ministry uses الصف الأول/الثاني/الثالث الثانوي for BOTH systems.
/// `badgeAr` carries the system-specific framing (مرحلة تمهيدية / سنة شهادة).
model AcademicYear {
  id        String @id @default(uuid(7)) @db.Uuid
  systemId  String @map("system_id") @db.Uuid
  year      Int
  labelAr   String @map("label_ar")
  badgeAr   String @map("badge_ar")
  sortOrder Int    @map("sort_order")

  system EducationSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([systemId, year])
  @@map("academic_years")
  @@schema("app")
}

/// 4 مسارات for البكالوريا, 3 شعب for الثانوية العامة. Both are chosen at the
/// start of year 2 — `minYear` encodes that, and year 1 has no track at all.
model Track {
  id        String   @id @default(uuid(7)) @db.Uuid
  systemId  String   @map("system_id") @db.Uuid
  slug      String
  labelAr   String   @map("label_ar")
  aliases   String[] @default([])
  minYear   Int      @default(2) @map("min_year")
  sortOrder Int      @map("sort_order")

  system          EducationSystem   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  faculties       TrackFaculty[]
  offerings       SubjectOffering[]
  electives       ElectiveGroup[]
  studentProfiles StudentProfile[]
  courses         Course[]

  @@unique([systemId, slug])
  @@map("tracks")
  @@schema("app")
}

/// Powers the reverse funnel: "اختار كليتك، نقولك مسارك".
model TrackFaculty {
  id        String @id @default(uuid(7)) @db.Uuid
  trackId   String @map("track_id") @db.Uuid
  nameAr    String @map("name_ar")
  sortOrder Int    @map("sort_order")

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("track_faculties")
  @@schema("app")
}

/// Canonical subject names only. A subject carries NO grading semantics —
/// الرياضيات appears in three different roles, so anything role-specific
/// (marks, level, whether it counts) belongs on SubjectOffering.
model Subject {
  id      String   @id @default(uuid(7)) @db.Uuid
  slug    String   @unique
  nameAr  String   @map("name_ar")
  aliases String[] @default([])

  offerings    SubjectOffering[]
  courses      Course[]
  accessGrants AccessGrant[]
  books        Book[]

  @@map("subjects")
  @@schema("app")
}

/// "Choose exactly 1 of these 2" for a given track and year.
model ElectiveGroup {
  id        String @id @default(uuid(7)) @db.Uuid
  trackId   String @map("track_id") @db.Uuid
  year      Int
  labelAr   String @map("label_ar")
  pickCount Int    @default(1) @map("pick_count")

  track     Track             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  offerings SubjectOffering[]

  @@unique([trackId, year, labelAr])
  @@map("elective_groups")
  @@schema("app")
}

/// The load-bearing table. A subject is only meaningful scoped by
/// (system, year, track) — a global `isCounted` flag on Subject would be wrong.
model SubjectOffering {
  id                  String        @id @default(uuid(7)) @db.Uuid
  systemId            String        @map("system_id") @db.Uuid
  year                Int
  trackId             String?       @map("track_id") @db.Uuid
  subjectId           String        @map("subject_id") @db.Uuid
  countsTowardTotal   Boolean       @default(true) @map("counts_toward_total")
  level               SubjectLevel?
  electiveGroupId     String?       @map("elective_group_id") @db.Uuid
  marks               Int           @default(100)
  passPercentOverride Decimal?      @map("pass_percent_override") @db.Decimal(5, 2)
  sortOrder           Int           @default(0) @map("sort_order")

  system            EducationSystem  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  subject           Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  track             Track?           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  electiveGroup     ElectiveGroup?   @relation(fields: [electiveGroupId], references: [id], onDelete: SetNull)
  electedByStudents StudentProfile[]

  // ⚠️ trackId is NULLABLE, and Postgres treats NULLs as DISTINCT in a unique
  // index. This constraint therefore does NOT prevent duplicate year-1 rows
  // (where trackId IS NULL). Step 3 adds a partial unique index to cover that
  // case, and the seed uses findFirst+create rather than upsert for those rows.
  @@unique([systemId, year, trackId, subjectId])
  @@index([systemId, year])
  @@map("subject_offerings")
  @@schema("app")
}

/// §6.2. `system`/`year`/`track`/`electiveSubject` are NULLABLE ON PURPOSE —
/// a grade-1 student legitimately has not chosen a system yet, and grade 1 is
/// common/non-specialized across both systems (§5.2). The
/// student_profiles_year1_has_no_track CHECK constraint (hand-written into
/// this model's migration — Prisma cannot express cross-column CHECKs) is the
/// database-level backstop for the one rule Zod alone can't fully guarantee
/// once a row is written directly. `phone` is `citext` so a student can't
/// register the same number twice under different casing/formatting quirks
/// (E.164 numbers aren't case-sensitive, but citext also normalises
/// comparison consistently with how the rest of this schema treats unique
/// natural keys).
model StudentProfile {
  userId                String    @id @map("user_id")
  fullName              String    @map("full_name")
  gender                Gender
  /// ⚠️ A MIRROR of `User.phoneNumber`, which is now the source of truth —
  /// not an independent field. Onboarding no longer asks for it; the number is
  /// captured at sign-up, and `ProfileService` copies it down here in the same
  /// write that creates the row, so the two cannot drift.
  ///
  /// Kept rather than dropped for two reasons. It is `citext @unique`, which
  /// is a genuinely stronger guarantee than the plain-text unique index on
  /// `users.phone_number` (see that field's note on why the authoritative
  /// column has to be byte-comparable), so it stays as a second net. And every
  /// admin list, outreach query and analytics join already reads it — moving
  /// them all in the same change that alters sign-up would put two unrelated
  /// risks in one migration.
  phone                 String    @unique @db.Citext
  /// Still unwritten. `User.phoneNumberVerified` is the column the OTP flow
  /// will set when it is turned on; this one predates it and is kept only so
  /// the mirror stays shaped like the original.
  phoneVerifiedAt       DateTime? @map("phone_verified_at")
  governorateCode       String    @map("governorate_code") @db.Char(2)
  schoolName            String?   @map("school_name")
  /// Nullable for the rows that predate the question, NOT because it is
  /// optional — onboarding requires it from here on. A student onboarded
  /// before this column existed genuinely has no answer, and inventing one
  /// (defaulting to `general`) would be the profile claiming a fact nobody
  /// ever told it.
  schoolStream          SchoolStream? @map("school_stream")
  fatherPhone           String?   @map("father_phone") @db.Citext
  /// No longer collected — onboarding asks for the father's number only. Kept
  /// so the numbers students already gave are not thrown away.
  motherPhone           String?   @map("mother_phone") @db.Citext
  systemId              String?   @map("system_id") @db.Uuid
  year                  Int?
  trackId               String?   @map("track_id") @db.Uuid
  electiveSubjectId     String?   @map("elective_subject_id") @db.Uuid
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  /// When this student first followed a WhatsApp link from the platform.
  ///
  /// The ONLY thing it is read for is to stop asking them again — «رسايل م.
  /// أيمن» skips anyone who has one. It is not analytics and nothing reports
  /// on it; a student who tapped the channel card once has answered the
  /// question the invitation exists to ask, and a platform that keeps asking
  /// after that is not paying attention.
  ///
  /// A timestamp rather than a boolean, matching every other soft-state column
  /// in this schema: it records WHEN, which a boolean throws away for no
  /// saving. Set once and never cleared — «مضغط قبل كده» does not stop being
  /// true, and re-arming it on a whim would resume pestering someone who
  /// already joined.
  ///
  /// ⚠️ It records the PRESS, not the join. WhatsApp tells us nothing, so
  /// this is the strongest signal that exists — and it is the honest one to
  /// gate on: what we can stop doing is asking someone who has already been
  /// sent there.
  whatsappOpenedAt DateTime? @map("whatsapp_opened_at")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  governorate     Governorate      @relation(fields: [governorateCode], references: [code])
  system          EducationSystem? @relation(fields: [systemId], references: [id])
  track           Track?           @relation(fields: [trackId], references: [id])
  electiveSubject SubjectOffering? @relation(fields: [electiveSubjectId], references: [id])

  @@index([governorateCode])
  @@index([systemId])
  @@map("student_profiles")
  @@schema("app")
}

// ── Content: courses, sections, lessons ──────────────────────────────────
// Plan 3, Task 3. `Course` also carries `enrollments Enrollment[]` and
// `grants AccessGrant[]` back-relations — those two fields are added by
// Task 4 alongside the Enrollment/AccessGrant models themselves, because
// Prisma requires both sides of a relation to be declared before the schema
// is valid, and those models do not exist yet at this point in history.

enum CourseStatus {
  draft
  published
  archived

  @@schema("app")
}

/// How strongly a course is being pushed at the student who is looking at it.
///
/// PRESENTATION ONLY. It changes the badge on the card and nothing else — not
/// visibility, not entitlement, not the progression gate. A course marked
/// `optional` is exactly as reachable as one marked `required`; the difference
/// is that the student is told which one to spend their evening on.
///
/// It exists because the catalog does not filter by the student's year and
/// deliberately so: a تأسيسي course is genuinely useful to both years, and
/// hiding it from the older one would be worse than showing it unranked. What
/// was missing was a way to SAY "this one matters for you, that one is there
/// if you want it" — which is a label, not a filter, and so is this.
enum CourseEmphasis {
  required
  recommended
  optional

  @@schema("app")
}

enum LessonKind {
  video
  quiz
  attachment
  text

  @@schema("app")
}

/// Seven providers even though v1 is YouTube-only. Widening a Postgres enum
/// later is an ALTER TYPE inside a migration that has to coordinate with a
/// deploy; widening it now is one line in a table nobody has written to yet.
enum VideoProvider {
  youtube
  upload
  vimeo
  bunny
  vdocipher
  ink
  gumlet

  @@schema("app")
}

/// The completion rule lives on the LESSON, not on the video or the quiz row —
/// a text lesson can require manual completion, a video lesson can require a
/// grade on its attached quiz, and putting the rule on the payload table would
/// make "how does this lesson complete?" a four-way union at read time.
enum CompletionMode {
  none
  manual
  on_view
  on_grade
  on_pass

  @@schema("app")
}

/// Courses are scoped by (system, year, track, subject) against the existing
/// taxonomy — the same tuple that identifies a SubjectOffering. The service
/// validates the tuple against subject_offerings on every write, because a
/// syntactically valid subject UUID can still belong to another system.
model Course {
  id           String       @id @default(uuid(7)) @db.Uuid
  slug         String       @unique @db.Citext
  title        String
  subtitle     String?
  description  String?
  systemId     String       @map("system_id") @db.Uuid
  year         Int
  trackId      String?      @map("track_id") @db.Uuid
  subjectId    String       @map("subject_id") @db.Uuid
  status       CourseStatus @default(draft)
  instructorId String       @map("instructor_id")

  /// مدارس عام / مدارس لغات. Independent of `systemId` and `trackId`: both
  /// stream types sit inside the same system and track and differ in the
  /// language the subject is taught in, so this is its own bit rather than
  /// more rows in the taxonomy.
  ///
  /// Two flags, not a three-valued enum, so a third stream is one more column
  /// instead of a combinatorial rewrite. `courses_serves_a_stream` forbids
  /// both being false — content nobody can reach should not be expressible.
  forGeneral   Boolean      @default(true) @map("for_general")
  forLanguages Boolean      @default(true) @map("for_languages")
  /// The storage KEY, never a full URL — same rule as media_assets (§6.7).
  coverKey     String?      @map("cover_key")
  /// Reserved. There is no payment system, so this is always 0 and NOTHING
  /// reads it. Entitlement is never derived from it — see AccessGrant.
  priceCents   Int          @default(0) @map("price_cents")

  /// Whether this course needs a grant of its OWN, rather than being covered
  /// by the platform-wide "free for everyone" grant.
  ///
  /// Named for what it does, not for money, and that is deliberate: the note
  /// on `priceCents` warns that a boolean `isFree` would be "the exact mistake
  /// §6.6 exists to prevent", and it is right about the mistake — deciding
  /// access from a column on the course instead of from a grant. This does not
  /// do that. It selects which grant SCOPES satisfy the course, and
  /// `EntitlementService` remains the only thing that says yes or no:
  ///
  ///   false → `platform`, `course` or `subject_teacher` all open it
  ///   true  → only `course` or `subject_teacher` do
  ///
  /// So a closed course still has a real grant behind every student who can
  /// read it, with a source, a validity window and an audit trail — which is
  /// what §6.6 is actually protecting.
  ///
  /// Flipping this to true does NOT close the course on students already
  /// enrolled: `LessonAccessService` gates on the enrollment, and an existing
  /// one stays valid. Deliberate — a student mid-course should not lose it
  /// under them — and the reason `EntitlementService.enroll` is the choke
  /// point rather than the player.
  requiresGrant Boolean     @default(false) @map("requires_grant")

  /// Subscription pricing, EGP cents. `null` = this plan is not for sale on
  /// this course — all three are independent, so a course can sell any
  /// subset of monthly/quarterly/yearly, or none.
  ///
  /// This is display/checkout pricing, not entitlement — same separation
  /// `requiresGrant`'s own note draws. Approving a `PaymentSubmission` is what
  /// creates the `AccessGrant` that actually opens the course; nothing ever
  /// reads these columns to decide who can see a lesson.
  ///
  /// The CHECK below is the one thing that DOES tie them to `requiresGrant`:
  /// a course for sale that is still open to every free platform grant would
  /// take everyone's money and give away the seat regardless, which is not a
  /// state this schema will represent.
  monthlyPriceCents   Int? @map("monthly_price_cents")
  quarterlyPriceCents Int? @map("quarterly_price_cents")
  /// A full-year subscription — same shape as `monthlyPriceCents`, and the
  /// same date-based expiry machinery: `PaymentPlan.yearly` maps to 12 months
  /// in `payment-expiry.ts`'s `PLAN_MONTHS`, reusing `computeApprovalValidUntil`
  /// exactly the way `monthly`/`quarterly` do. Unlike `term`, this is NOT
  /// open-ended and creates no `scope: term` grant — it is a `scope: course`
  /// grant with a real calendar expiry, same as every other whole-course plan.
  yearlyPriceCents Int? @map("yearly_price_cents")

  /// الكتاب الورقي — a printed textbook this course ships to a student's
  /// door, entirely independent of the subscription plans above: a course
  /// can be free to attend and still sell a book, or priced and sell none.
  /// `null` = this course has no book to order at all, and is what gates
  /// «اطلب الكتاب» on the public course page — see `CatalogCourseDetail
  /// Schema.bookTitle`.
  ///
  /// One book per course, not a catalog of its own: the admin edits it right
  /// alongside the subscription prices in the SAME course editor, the same
  /// convention `monthlyPriceCents` set for "display data the editor owns
  /// directly", nothing else reads or writes it.
  bookTitle      String? @map("book_title")
  /// EGP cents, same convention as `monthlyPriceCents` — `null` exactly when
  /// `bookTitle` is `null`, enforced by `courses_book_needs_price_and_title`
  /// (hand-written into the migration, same convention as
  /// `courses_priced_requires_grant`) so a book can never exist with no
  /// price or a price with no book.
  bookPriceCents Int?    @map("book_price_cents")

  position     Int          @default(0)

  /// The badge on this course's card — «إجباري» / «موصى به» / «اختياري».
  /// `null` is the default and means no badge at all, which is most courses:
  /// a platform where every card shouts has no emphasis left to give.
  /// See `CourseEmphasis` for why this is a label and not a filter.
  emphasis     CourseEmphasis? @map("emphasis")

  /// The one line under the badge — «أساسي لأولى بكالوريا · اختياري لتانية».
  ///
  /// Free text rather than a second enum, because the thing it has to express
  /// is "for WHOM", and that varies per course in ways a fixed vocabulary
  /// cannot cover. It is only ever rendered next to a badge: the CHECK below
  /// forbids a note with no `emphasis`, so there is no state where a sentence
  /// floats on a card with nothing to attach it to.
  emphasisNote String?      @map("emphasis_note")

  /// The custom «لسه هننزل قريبًا» message for a course with zero real
  /// lectures published yet — a course that is up for enrolment/subscription
  /// before its first lecture ships, so the sales pitch is a badge and a
  /// promise rather than an outline.
  ///
  /// `null` is the default and every course today. It does NOT mean "say
  /// nothing" — the course page and the enrolled-course card fall back to a
  /// platform-wide stock sentence (`copy.course.comingSoonDefaultNote`) so
  /// the state is always explained, and this column only lets an instructor
  /// override that wording per course («التسجيلات بتتصور دلوقتي، هتتنزل
  /// الأسبوع الجاي» rather than the generic line).
  ///
  /// "Zero real lectures" is decided the same way `DashboardService`,
  /// `CourseProgressService` and `CatalogService` already decide it —
  /// `isPublished && section.isPublished && kind != 'quiz'` — never a second,
  /// looser definition. This column is purely presentational, the same
  /// distinction `emphasisNote`'s own note draws: it renders a message, it
  /// enrolls or blocks nothing, and a course with this set is exactly as
  /// subscribable as one without it.
  comingSoonNote String?    @map("coming_soon_note")

  /// «مواعيد المحاضرات» — the live-lesson time, as one line the teacher writes.
  ///
  /// Free text and NOT a weekday + a time. The giveaway is in the ask itself:
  /// «هضيف السبت الساعة تمانية… طيب لو لغات، فيبقى يوم الحد» — two courses, two
  /// nights, typed by the person who teaches them. A structured pair buys
  /// sorting and localisation nothing here asks for, and cannot say «السبت
  /// والتلات ٨ م» or «الأسبوع ده استثناءً الأحد» — each of which is otherwise a
  /// phone call.
  ///
  /// Nothing reasons about this column; it is a label the student reads in the
  /// dashboard band. A reminder («المحاضرة بعد ساعة») would need its own
  /// structured column and this one would stay as the label beside it.
  ///
  /// NULL = «مفيش ميعاد معلن», which is every course until somebody writes one.
  /// 120 chars, enforced by `courses_schedule_note_length` — the ceiling is the
  /// single line it gets in the hero on a phone, not a guess about content.
  scheduleNote   String?    @map("schedule_note")

  /// اكتمل نزول المحتوى — set by the instructor, never derived.
  ///
  /// Gates the word «خلصت الكورس» on every screen that draws a completed
  /// course. Progress percentages, ticks and the exam gate are unaffected:
  /// they are all about what the student has done with what EXISTS, and this
  /// is about whether what exists is all there will be.
  contentComplete Boolean @default(false) @map("content_complete")

  /// The course's final exam, if it has one: a lesson of kind `quiz` belonging
  /// to THIS course.
  ///
  /// An exam is a lesson rather than a second kind of quiz owner, which is
  /// what lets the whole quiz engine — versioned questions, option-order
  /// snapshots, attempt tokens, grading, the review matrix — apply to it with
  /// no branch anywhere. Its result is an ordinary `LessonProgress` row, so
  /// there is no second definition of "the student's exam score" that could
  /// drift from the engine's own.
  ///
  /// The improvement sitting is a second PAPER on this same quiz for the same
  /// reason (see `QuizPaper`), not a second exam lesson — which would recreate
  /// exactly the drift this arrangement exists to prevent.
  ///
  /// Two rules make it an exam rather than a late lesson, and both live in the
  /// progression gate: it unlocks only when every OTHER published lesson is
  /// cleared, and a course is not complete until it is passed. That first rule
  /// is why this is a column and not a convention about position.
  ///
  /// `onDelete: SetNull` — deleting the exam lesson unsets the pointer rather
  /// than cascading the course away.
  /// ⚠️ `@db.Uuid` is load-bearing. The column has been UUID since
  /// 20260802140000_course_exam, but this line said `String?` (text), so
  /// Prisma diffed the two as different types and believed the column needed
  /// converting on every migration. A `prisma migrate dev` run acting on that
  /// belief dropped BOTH `courses_exam_lesson_id_fkey` and
  /// `courses_exam_lesson_in_same_course` — the second being what stops a
  /// course claiming another course's exam — then failed re-adding the first
  /// against `lessons.id` (42804), leaving the table with neither.
  ///
  /// Schema-only fix: the deployed column is already UUID, so this needs no
  /// migration. It just stops the diff, and therefore the whole sequence.
  examLessonId String?      @unique @map("exam_lesson_id") @db.Uuid

  publishedAt  DateTime?    @map("published_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  system      EducationSystem @relation(fields: [systemId], references: [id], onDelete: Restrict)
  track       Track?          @relation(fields: [trackId], references: [id], onDelete: Restrict)
  subject     Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  instructor  User            @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  examLesson  Lesson?         @relation("CourseExam", fields: [examLessonId], references: [id], onDelete: SetNull)
  sections    CourseSection[]
  /// الترم الأول / الترم الثاني — see `CourseTerm`'s own doc.
  terms       CourseTerm[]
  lessons     Lesson[]
  enrollments Enrollment[]
  grants      AccessGrant[]
  // Articles whose call to action points at this course.
  newsPosts   NewsPost[]
  paymentSubmissions PaymentSubmission[]
  bookOrders  BookOrder[]
  /// The catalogue entry for this course's printed textbook, if the shop
  /// carries it. At most one — `books.course_id` is UNIQUE, so a course can
  /// never end up with two entries quoting two prices.
  book        Book?

  // `courses_priced_requires_grant` (hand-written into the migration, same
  // convention as `courses_note_needs_emphasis`) enforces that a course with
  // either price set also has `requiresGrant = true` — see the note on
  // `monthlyPriceCents` above.
  @@index([status, publishedAt])
  @@index([systemId, year, trackId, subjectId])
  @@map("courses")
  @@schema("app")
}

/// "شهر" / "الباقة" were PRICING concepts and had to never appear as content
/// levels. `termId` below is the one deliberate exception: a "Term" (الترم) IS
/// now a content grouping ON PURPOSE — see `CourseTerm`'s own doc — a section
/// is still a chapter of a course, just optionally one that also belongs to a
/// half of it.
model CourseSection {
  id          String   @id @default(uuid(7)) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  /// `null` = this section is not assigned to either half of the course —
  /// the normal state for a course that has no terms configured at all, and
  /// also legal on one that does (a section everyone can always reach,
  /// regardless of which terms are open, e.g. an intro/orientation unit).
  /// Only a section WITH a term can ever be shut by closing one.
  termId      String?  @map("term_id") @db.Uuid
  title       String
  summary     String?
  /// Ordering is position + an id tie-break. Never a CSV sequence column.
  position    Int
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course  Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term    CourseTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)
  lessons Lesson[]

  // Re-created as DEFERRABLE INITIALLY DEFERRED in the hand-written migration
  // (Task 3, Step 7). Prisma cannot express deferrability and does not
  // introspect it, so declaring it here keeps `migrate dev` from reporting
  // drift while the real constraint is the deferrable one.
  @@unique([courseId, position], map: "course_sections_course_position_key")
  // Backs `lessons_section_matches_course` — the composite FK the
  // content_constraints migration (Task 3) adds so a lesson's denormalised
  // course_id structurally has to match its section's. Declaring the unique
  // half here keeps `migrate dev`'s drift check quiet about it; Prisma has no
  // way to express the composite FK itself (it isn't a modelled relation), so
  // that half stays invisible to Prisma and must never be "corrected" away.
  @@unique([id, courseId], map: "course_sections_id_course_key")
  @@index([termId])
  @@map("course_sections")
  @@schema("app")
}

/// الترم الأول / الترم الثاني — a division of ONE COURSE's own content, not a
/// separate concept from sections/lessons: a term is a grouping OF them.
/// Confirmed against the request itself ("تقسيم لمحتوى الكورس نفسه"), and it
/// is why this table gains a `CourseSection.termId`, not the other way
/// around — a term does not own content directly, it claims existing
/// sections.
///
/// ## Why a new table instead of reusing `CourseSection` as the unit
///
/// A section is already the chapter unit `SectionService`/the admin editor
/// build around, and terms need to group MULTIPLE sections (a term is
/// several weeks of chapters), so a term has to sit a level above it, not
/// replace it.
///
/// ## `isOpen`, not a second `status`
///
/// A term does not have a draft/published lifecycle of its own — its
/// SECTIONS and LESSONS keep their own `isPublished` exactly as before, term
/// or no term. `isOpen` answers a single, different question: "does buying
/// or already holding a `scope: term` grant for this term currently work".
/// Closing it does not unpublish anything; it cuts off ACCESS, the same way
/// `Course.requiresGrant` gates a whole course without touching any lesson's
/// own publish flag.
///
/// ## Closing is enforced by revoking grants, not by reading `isOpen` at
/// request time
///
/// `EntitlementService`/`LessonAccessService` never check this column. The
/// actual cutoff a closed term produces is `TermService.setOpen` bulk-
/// stamping `revokedAt` on every live `scope: term` grant for it, in one
/// transaction with one audit row — the exact mechanism
/// `LessonAccessService.require`'s existing "expired/revoked" re-check
/// already enforces for a lapsed subscription. `isOpen` only gates two
/// things: whether a STUDENT may buy this term (`PaymentsService.submit`)
/// and whether an admin's manual-subscribe offers it — access itself is
/// always decided by reading grants, never a boolean on the course, per this
/// schema's standing rule (see `Course.requiresGrant`'s own note).
///
/// ## Reopening
///
/// Flipping `isOpen` back to `true` only re-enables new purchases. It does
/// NOT restore a grant this term's own closing revoked — those are gone the
/// same permanent way `AdminStudentSubscriptionsController`'s cancel is
/// (`revokedAt` is stamped, never cleared, everywhere else in this schema).
/// A student who wants back in buys (or is granted) the term again, which
/// writes a fresh row. Simplest correct v1 behaviour, stated once here
/// rather than re-derived at every call site.
///
/// ## Price lives HERE, not as a third flat column on `Course`
///
/// Same shape as `Course.monthlyPriceCents`/`quarterlyPriceCents`: display
/// and checkout data only, `null` = not for sale. Per-term rather than
/// per-course because a course's two terms are not guaranteed to be worth the
/// same to a student joining mid-year.
model CourseTerm {
  id         String   @id @default(uuid(7)) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  title      String
  /// Ordering is position + an id tie-break, same convention as every other
  /// orderable table in this schema.
  position   Int
  isOpen     Boolean  @default(true) @map("is_open")
  priceCents Int?     @map("price_cents")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections           CourseSection[]
  accessGrants       AccessGrant[]
  paymentSubmissions PaymentSubmission[]

  @@unique([courseId, position])
  @@map("course_terms")
  @@schema("app")
}

model Lesson {
  id        String     @id @default(uuid(7)) @db.Uuid
  /// Denormalised from section.courseId so course-wide queries (lesson counts,
  /// total duration, the sitemap) do not need a join. Written by the service on
  /// create and never accepted from a client.
  courseId  String     @map("course_id") @db.Uuid
  sectionId String     @map("section_id") @db.Uuid
  title     String
  kind      LessonKind
  position  Int

  isPublished      Boolean @default(false) @map("is_published")
  isFreePreview    Boolean @default(false) @map("is_free_preview")
  estimatedSeconds Int     @default(0) @map("estimated_seconds")

  /// Per-lesson stream, same two flags as the course — a course can serve both
  /// and still teach one lecture only to لغات.
  ///
  /// Independent of the course's pair, and deliberately NOT intersected with
  /// it at read time. The stream is a label and a filter, not an entitlement:
  /// nothing is hidden from anyone, so a lesson narrower than its course is a
  /// labelling mistake rather than an access bug. The admin surfaces it as a
  /// warning next to the lesson; silently rewriting or dropping it at read
  /// time would hide the mistake instead of showing it.
  forGeneral       Boolean @default(true) @map("for_general")
  forLanguages     Boolean @default(true) @map("for_languages")

  // ── RESERVED, UNENFORCED IN V1 (Global Constraint 17) ───────────────────
  // These columns exist so the later ALTER TABLE is not a migration across a
  // large, hot table. NOTHING in v1 reads them for an access decision and NO
  // v1 DTO accepts them — LessonCreateDto/LessonUpdateDto reject them with a
  // 400 rather than stripping them, so a half-enforced gate cannot appear by
  // accident. When they are switched on, that is its own plan with its own
  // authorization matrix tests.
  visibleFrom          DateTime? @map("visible_from")
  visibleTo            DateTime? @map("visible_to")
  unlocksAfterLessonId String?   @map("unlocks_after_lesson_id") @db.Uuid
  viewLimit            Int?      @map("view_limit")
  /// content_groups is a v1.1 table (shared lesson sets across courses). The
  /// column is reserved WITHOUT a foreign key so the FK can be added later in
  /// one statement against all-NULL data. All-NULL today, so tightening the
  /// type now (ahead of that future FK) is free.
  contentGroupId       String?   @map("content_group_id") @db.Uuid

  // ── Completion rule ────────────────────────────────────────────────────
  completionMode           CompletionMode @default(manual) @map("completion_mode")
  completionMinViewSeconds Int?           @map("completion_min_view_seconds")
  completionPassGrade      Decimal?       @map("completion_pass_grade") @db.Decimal(6, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section      CourseSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  unlocksAfter Lesson?            @relation("LessonUnlock", fields: [unlocksAfterLessonId], references: [id], onDelete: SetNull)
  unlocks      Lesson[]           @relation("LessonUnlock")
  video        LessonVideo?
  text         LessonText?
  resources    LessonResource[]
  resumedBy    Enrollment[]       @relation("EnrollmentLastLesson")
  /// Back-relation for `Course.examLessonId`. At most one course points here
  /// (that column is `@unique`), and the composite FK in the migration means
  /// it can only ever be this lesson's OWN course.
  examOfCourse Course?            @relation("CourseExam")
  /// Plan 4 Task 2's own back-relation.
  progress     LessonProgress[]
  /// Plan 5 Task 2's own back-relation. At most one quiz per lesson.
  quiz         Quiz?
  /// Slice 3's back-relation — one row per sitting at this lesson.
  viewSessions LessonViewSession[]

  @@unique([sectionId, position], map: "lessons_section_position_key")
  // Backs `courses_exam_lesson_in_same_course` — the composite FK the
  // course_exam migration adds so `courses.exam_lesson_id` can only point at a
  // lesson of that same course. Same shape, and same reason, as
  // `course_sections_id_course_key` above: Prisma cannot express the composite
  // FK itself (it is not a modelled relation), so declaring the unique half
  // here keeps `migrate dev`'s drift check quiet and the FK stays invisible to
  // Prisma. Never "correct" this away.
  @@unique([id, courseId], map: "lessons_id_course_key")
  @@index([courseId, isPublished])
  @@map("lessons")
  @@schema("app")
}

/// 1:1 with a lesson. `externalId` is the ELEVEN-CHARACTER provider id — never
/// a URL. A CHECK constraint in the hand-written migration enforces that even
/// against a direct SQL write, so the invariant does not depend on the
/// application layer remembering.
model LessonVideo {
  lessonId        String        @id @map("lesson_id") @db.Uuid
  provider        VideoProvider
  externalId      String        @map("external_id")
  durationSeconds Int           @map("duration_seconds")
  posterKey       String?       @map("poster_key")
  captions        Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_videos")
  @@schema("app")
}

/// 1:1 with a lesson. `bodyHtml` is ALWAYS sanitize-html output — nothing
/// writes this column without going through sanitizeRichText().
model LessonText {
  lessonId  String   @id @map("lesson_id") @db.Uuid
  bodyHtml  String   @map("body_html")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_texts")
  @@schema("app")
}

/// Exactly one payload is legal per `kind`, enforced by CHECK constraints in
/// the migration rather than by a service `if`: a resource that lies about its
/// own kind cannot exist even under a direct SQL write.
enum LessonResourceKind {
  /// The deck the lesson was taught from. At most ONE per lesson — a partial
  /// unique index, not application logic.
  presentation
  video
  document
  link

  @@map("lesson_resource_kind")
  @@schema("app")
}

/// The material set of a lesson: the deck it was taught from, tutorial videos,
/// documents, and links out.
///
/// ANY lesson kind may carry these — a video lesson with a presentation and
/// three materials is the common case, which is why the write path has no
/// `assertKind` gate. Its predecessor `LessonAttachment` required
/// `kind === 'attachment'`, which is precisely why materials could not be
/// attached to the lessons that most needed them.
model LessonResource {
  id          String             @id @default(uuid(7)) @db.Uuid
  lessonId    String             @map("lesson_id") @db.Uuid
  kind        LessonResourceKind
  title       String
  /// Plain text, never HTML — nothing here needs sanitizeRichText(), and not
  /// accepting HTML is cheaper than sanitising it.
  description String?
  position    Int                @default(0)

  // ── payload: file (presentation | document) ────────────────────────────
  /// The storage KEY, never a URL — same rule as media_assets (§6.7).
  storageKey String? @map("storage_key")
  filename   String?
  mime       String?
  sizeBytes  Int?    @map("size_bytes")

  // ── payload: video ─────────────────────────────────────────────────────
  /// The ELEVEN-CHARACTER provider id, never a URL. `extractYouTubeId` parses
  /// the URL and discards it, which is what eliminates the SSRF class.
  videoProvider   VideoProvider? @map("video_provider")
  videoExternalId String?        @map("video_external_id")

  // ── payload: link ──────────────────────────────────────────────────────
  /// `https:` only, enforced at the DTO and by a CHECK. Rendered as an anchor,
  /// never fetched server-side.
  linkUrl String? @map("link_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Still no unique constraint on (lessonId, position), inherited deliberately
  // from lesson_attachments: ordering is (position, id) with duplicates
  // tolerated. That is also why this table needs no DEFERRABLE constraint the
  // way lessons and course_sections do — the intermediate duplicate positions
  // inside buildReorderSql's single UPDATE are legal because nothing forbids
  // them at any point. Do not "fix" this by adding a unique index.
  @@index([lessonId, position])
  @@map("lesson_resources")
  @@schema("app")
}

// ── Entitlement: access grants, not a boolean ────────────────────────────
// Plan 3, Task 4. Everything is free in v1 — that is a ROW, not an `if`.

/// RECONCILED: this is the canonical set. Plan 4's draft used
/// `active|expired|revoked|completed` and Plan 3's used
/// `active|suspended|completed|cancelled`; the union below is what ships, and
/// `@@map` is present on every enum in this block so the raw SQL in Plan 4's
/// heartbeat service can cast to a predictable snake_case type name.
///
/// `status` deliberately stays `active` when a course is finished — only
/// `completedAt` is set. Flipping to `completed` would drop the enrollment out
/// of every `status: 'active'` ownership filter in Plans 4 and 5, i.e.
/// finishing a course would revoke access to it.
enum EnrollmentStatus {
  active
  suspended
  expired
  revoked
  completed

  @@map("enrollment_status")
  @@schema("app")
}

/// How the enrollment came to exist. v1 wrote only `free`; `purchase` is now
/// written too, by `PaymentsService` on an approved submission. The rest
/// remain reserved for the access-code and coupon flows.
enum EnrollmentSource {
  free
  manual
  purchase
  coupon
  code

  @@map("enrollment_source")
  @@schema("app")
}

/// §6.6. Even though everything is free, entitlement is an OBJECT with a scope
/// and a validity window. "Free for everyone" is expressed as one platform-scoped
/// grant per user, created lazily on first enrollment — not as
/// `if (course.priceCents === 0) return true`. Turning a boolean `hasCourse`
/// into this shape after launch is a data migration across every enrollment;
/// shipping the shape now costs one table.
enum AccessScope {
  platform
  course
  subject_teacher
  unassigned
  /// Scoped to ONE `CourseTerm` — الترم الأول / الترم الثاني. Satisfies
  /// `resolveCourseAccess` (so a term-only buyer can still enrol and is
  /// counted as "having some access" to the course) but is NOT enough on its
  /// own to open a lesson belonging to a DIFFERENT term — see
  /// `EntitlementService.resolveTermAccess`, the extra check
  /// `LessonAccessService.require` runs only when the winning grant is this
  /// scope. `platform`/`course`/`subject_teacher` all cover EVERY term
  /// regardless of open/closed state; only this scope is term-specific.
  term

  @@map("access_scope")
  @@schema("app")
}

/// Where the grant came from. RECONCILED: Plan 4's draft called this enum
/// `AccessSource` with `free|manual|purchase|coupon|code|scholarship`. The name
/// `GrantSource` (Plan 3, earliest) wins; the value set below is the union, so
/// Plan 4 never needs an `ALTER TYPE`. v1 wrote only `auto_free`; `purchase`
/// is now written too — see `PaymentSubmission`.
enum GrantSource {
  auto_free
  admin
  access_code
  purchase
  coupon
  scholarship

  @@map("grant_source")
  @@schema("app")
}

/// Reserved so a scholarship grant is a row, not a schema change. Unused in v1.
enum ScholarshipKind {
  orphans
  financial
  twinz

  @@map("scholarship_kind")
  @@schema("app")
}

model AccessGrant {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @map("user_id")
  scope           AccessScope
  courseId        String?          @map("course_id") @db.Uuid
  subjectId       String?          @map("subject_id") @db.Uuid
  /// Reserved for the `subject_teacher` scope. No FK in v1 — there is exactly
  /// one instructor and adding the FK later is one statement against NULLs.
  instructorId    String?          @map("instructor_id")
  /// Set only for `scope: term`. Always paired with `courseId` on that scope
  /// (denormalised, same as `subjectId` is for `subject_teacher`) so a plain
  /// `courseId` filter still finds every term grant for a course.
  termId          String?          @map("term_id") @db.Uuid
  source          GrantSource
  scholarshipKind ScholarshipKind? @map("scholarship_kind")
  validFrom       DateTime         @default(now()) @map("valid_from")
  /// NULL = open-ended. v1 always wrote NULL; a `purchase` grant now writes a
  /// real date — `PaymentsService` is what makes a term-limited grant a data
  /// change instead of a schema change, exactly as this note anticipated.
  /// RECONCILED: Plan 4's draft called this `validTo`. `validUntil` wins.
  ///
  /// A `scope: term` grant ALSO always writes NULL here — it is not
  /// date-limited at all, the way monthly/quarterly are. Its cutoff is
  /// `revokedAt`, stamped in bulk the moment an admin closes the term (see
  /// `TermService.setOpen`), not a calendar date. Do not read a `null` here on
  /// a term grant as "expired math pending"; it is the permanent shape of
  /// that scope.
  validUntil      DateTime?        @map("valid_until")
  revokedAt       DateTime?        @map("revoked_at")
  grantedByUserId String?          @map("granted_by_user_id")
  note            String?
  /// The admin's OWN reason for an early cancellation via `/admin/finance`
  /// (`FinanceService.cancel`) — distinct from `note`, which is a
  /// system-authored provenance string ("purchase: submission X"). `null`
  /// whenever this grant was never cancelled that way (including every grant
  /// that lapsed on its own `validUntil`, or was revoked through the older
  /// `PaymentsService.adminCancelSubscription` path, which has no reason
  /// field at all).
  cancelReason String? @map("cancel_reason")
  /// Whether `cancelReason` should ever reach the student — a SEPARATE choice
  /// from writing the reason at all. Defaults `false`: an admin explaining to
  /// himself why he cut a subscription short must not become
  /// student-visible by default just because he typed something. See
  /// `NotificationsService`'s `subscription_cancelled` kind, which is only
  /// ever emitted when this is `true`.
  cancelReasonVisibleToStudent Boolean @default(false) @map("cancel_reason_visible_to_student")
  createdAt       DateTime         @default(now()) @map("created_at")

  user      User        @relation("AccessGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?       @relation("AccessGrantIssuer", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  course    Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term      CourseTerm? @relation(fields: [termId], references: [id], onDelete: Cascade)
  /// Payment submissions this SPECIFIC grant was created or extended by — the
  /// audit link from money to access. Not every grant has one: `admin` and
  /// `auto_free` grants never do.
  paymentSubmissions PaymentSubmission[]

  @@index([userId, scope])
  @@index([courseId])
  /// The bulk-revoke-on-close query's own index: "every live grant for THIS
  /// term" — see `TermService.setOpen`.
  @@index([termId])
  @@map("access_grants")
  @@schema("app")
}

/// The subscription lengths sold — see `Course.monthlyPriceCents`.
///
/// `term` is an independent option, not a replacement for the others: a
/// student who wants the whole course still buys monthly/quarterly/yearly,
/// and one who wants only «الترم الأول» buys just that. Unlike `term`, the
/// other three are all date-limited — see `AccessGrant.validUntil`'s note on
/// what a `scope: term` grant writes there instead, and `CourseTerm`'s own
/// doc for what actually cuts a term off.
///
/// `yearly` is a full-year subscription, added alongside monthly/quarterly —
/// same `scope: course`, date-based expiry machinery (`payment-expiry.ts`'s
/// `PLAN_MONTHS.yearly = 12`), NOT the term treatment.
enum PaymentPlan {
  monthly
  quarterly
  term
  yearly

  @@map("payment_plan")
  @@schema("app")
}

/// A student's claim to have paid — reviewed by an admin before it becomes
/// real access.
enum PaymentSubmissionStatus {
  pending
  approved
  rejected

  @@map("payment_submission_status")
  @@schema("app")
}

/// A student's claim to have paid for a course subscription over Vodafone
/// Cash, and what an admin decided about it.
///
/// ## Why this is not a shape bolted onto `AccessGrant`
///
/// Every row in `AccessGrant` is real access — live or revoked, but access
/// that once was genuine. A REJECTED claim is the opposite: a student said
/// they paid and an admin said no. It has to be recorded (the whole point of
/// the review queue is an audit trail an admin can be second-guessed against
/// later) without ever having been access, which `AccessGrant` has no shape
/// for and should not grow one just to hold a denial.
///
/// So approving a submission is the action that CREATES or EXTENDS a real
/// `AccessGrant` (`grantId` points at the result); rejecting one leaves no
/// grant at all, and the submission row is the only trace it ever happened.
///
/// ## Why approval EXTENDS one grant rather than stacking many
///
/// A student who renews before expiring must not end up with two live
/// `scope: course` grants for the same course — `AdminStudentsService
/// .grantCourse`'s own note is the reason: two open grants make revoking the
/// course a two-step operation nobody would remember, and
/// `resolveCourseAccess` would have to reason about which of several
/// overlapping windows is authoritative for no benefit. `PaymentsService`
/// instead extends the one live `purchase` grant's `validUntil` from whichever
/// is later — its current expiry or now — so renewing before the old term
/// ends adds the new term on top instead of discarding the remainder. The
/// submissions table already IS the append-only history of every payment;
/// the grant only ever needs to say "valid until when", not "why, three times
/// over".
model PaymentSubmission {
  id       String       @id @default(uuid(7)) @db.Uuid
  userId   String       @map("user_id")
  courseId String       @map("course_id") @db.Uuid
  plan     PaymentPlan
  /// Set exactly when `plan = term` — which of the course's two (or more)
  /// terms this claim is for. `onDelete: SetNull` rather than `Cascade`: this
  /// row is money-history and must survive a term being renamed/removed even
  /// though v1's admin UI never deletes one.
  termId   String?      @map("term_id") @db.Uuid

  /// The chosen plan's price at submission time — derived from the course's
  /// own `monthlyPriceCents`/`quarterlyPriceCents`/the term's own
  /// `priceCents`, never student input. What
  /// the student actually supplies is `senderPhone` below; this column exists
  /// so an approved/rejected row still says what the claim was worth without
  /// a join back to a price that may since have changed.
  ///
  /// For an `isFree` row this is what the term would normally have cost, NOT
  /// what was collected (nothing was) — see `isFree`'s own note. Every priced
  /// plan's price is `> 0`, so `amountCents` alone can never distinguish "the
  /// admin comped this" from "somehow paid zero"; that is `isFree`'s job.
  amountCents Int @map("amount_cents")

  /// The Vodafone Cash number the transfer was sent FROM. Often not the
  /// student's own account phone (a parent's line is common) — this is what
  /// an admin actually reconciles against the real Vodafone Cash log, which
  /// is why it replaced an admin-unchecked "amount I sent" field.
  ///
  /// `null` for a row `PaymentsService.adminManualSubscribe` created directly
  /// — there is no Vodafone Cash transfer to reconcile, because the money (if
  /// any) moved somewhere this platform never sees.
  senderPhone String? @map("sender_phone")

  /// The storage KEY of the uploaded screenshot — same convention as
  /// `courses.cover_key`, never a full URL. Served only through the gated
  /// admin review route (`GET /admin/payments/submissions/:id/screenshot`),
  /// never through the public `/media/:prefix/:name` path: this image can
  /// carry the student's name, phone number and balance.
  ///
  /// `null` for the student-facing flow's OWN submissions is impossible
  /// (`SubmitPaymentSchema` requires one) but is the NORMAL case for a row
  /// `adminManualSubscribe` creates directly: proof of a transfer he already
  /// received is something he MAY attach, not something the API demands —
  /// unlike the student-facing upload, which stays required.
  screenshotKey String? @map("screenshot_key")

  /// An admin recording a payment (or comping a term) that happened OUTSIDE
  /// this review flow entirely — a transfer he already received over
  /// WhatsApp, or a term he is giving away free. The grant this produces is
  /// exactly as real as one `approve()` created from a genuine submission,
  /// computed by the same `computeApprovalValidUntil`; the ONLY thing this
  /// flag changes is `/admin/finance`'s revenue total, which must never count
  /// money nobody actually collected. See `FinanceService.list`'s revenue
  /// aggregate and `finance-status.ts`'s `countsAsRevenue`.
  ///
  /// A NEW field rather than overloading `amountCents = 0`: a priced plan's
  /// price is never zero, so `amountCents` alone already happens to
  /// distinguish the two cases today, but relying on that silently would
  /// make the revenue query correct by coincidence rather than by contract —
  /// the day a `0`-cent plan is ever allowed, that coincidence breaks with no
  /// type error anywhere to catch it.
  isFree Boolean @default(false) @map("is_free")

  status PaymentSubmissionStatus @default(pending)

  /// Admin-authored, shown to the student. `null` unless `status = rejected`.
  /// Free text, not a coded reason: Global Constraint 4 is about the
  /// PLATFORM'S copy, not a human explaining a specific decision to a
  /// specific student.
  rejectionReason String? @map("rejection_reason")

  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")

  /// Set on approval only — see the model note on why rejection leaves this
  /// `null` rather than pointing at a grant that was never created.
  grantId String? @map("grant_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user       User         @relation("PaymentSubmissionStudent", fields: [userId], references: [id], onDelete: Cascade)
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewedBy User?        @relation("PaymentSubmissionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  grant      AccessGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  term       CourseTerm?  @relation(fields: [termId], references: [id], onDelete: SetNull)

  /// The review queue: pending first, oldest first — a submission review is
  /// first-come-first-served like a support ticket.
  @@index([status, createdAt])
  /// "Has this student got one already sitting in the queue" — the duplicate
  /// check `PaymentsService.submit` runs before accepting a new one.
  @@index([userId, courseId, status])
  @@map("payment_submissions")
  @@schema("app")
}

/// One student's order for the printed textbook of a course that has one —
/// see `Course.bookTitle`. Deliberately its OWN table, not a row on
/// `PaymentSubmission`: a book order has an address and a shipping state
/// `PaymentSubmission` has no shape for, grants no `AccessGrant` at all (a
/// book is a physical object, not platform access), and mixing the two would
/// corrupt `/admin/finance`'s revenue reporting, which reads `PaymentSubmission`
/// as "money for a subscription" exclusively.
///
/// ## Three states, two of them recorded as timestamps rather than a bigger enum
///
/// `status` starts at `address_only` — written the moment the address form is
/// submitted, BEFORE any payment, so an admin can already see "someone
/// started an order" even if the student abandons here. `paidAt` is set (and
/// `status` moves to `paid`) once the Vodafone Cash screenshot is submitted —
/// see the note below on why that alone is enough to count as "paid", with no
/// separate admin-approval click. `shippedAt` (and `status: shipped`) is set
/// only by `BookOrdersService.markShipped`, an explicit admin action.
///
/// `status` is redundant with "`paidAt` is set" / "`shippedAt` is set" in the
/// same sense `PaymentSubmission.status` is not redundant with anything —
/// it exists so `/admin/books`'s paid/incomplete split and the shipped filter
/// are each a single indexed equality check, not a `paidAt IS NOT NULL` scan.
///
/// ## Why submitting the screenshot IS "paid" — no pending → approved step
///
/// `PaymentSubmission` gates on admin approval because approving it grants
/// REAL platform access — a mistake there is a security incident. A book
/// order grants nothing: the worst case of a bad screenshot is a book shipped
/// to the wrong story, which is a shipping-desk problem, not an access one.
/// `BookOrdersService.markShipped` is where an admin actually looks at the
/// screenshot before doing anything irreversible (posting a physical book) —
/// a second, earlier approval gate would just be the same human decision
/// asked for twice.
/// Which half of the school year a book covers.
///
/// `full` is a real third value rather than "both terms": a single-volume book
/// for the whole year is one OBJECT with one price and one cover, and modelling
/// it as a pair would let a student buy the same book twice. The public
/// catalogue groups on this column, so it is also the heading a reader sees.
enum BookTerm {
  first
  second
  full

  @@map("book_term")
  @@schema("app")
}

/// One book on sale — the catalogue `/books` is made of.
///
/// ## Why this is a table and not more columns on `Course`
///
/// `Course.bookTitle`/`bookPriceCents` shipped first and modelled exactly one
/// thing: the printed textbook OF a course. Three things it cannot express were
/// then asked for at once — a book with no course behind it (a revision
/// booklet, a past-papers collection, a second-term volume for a subject whose
/// course is not recorded yet), more than one book in one delivery, and a
/// quantity. None of those is a column; all of them are a catalogue.
///
/// Those two course columns are deliberately still here and still authoritative
/// for the course page's own «اطلب الكتاب» button. This table's `courseId`
/// links a catalogue row back to that course when the two are the same book, so
/// the shop can show it without a second, drifting copy of its price.
///
/// ## Why `subjectId` is nullable and `year` is a plain Int
///
/// The catalogue is grouped «المادة ← الترم», so a book with no subject has
/// nowhere to sit and is filed under «كتب عامة» instead of being rejected — a
/// revision booklet spanning three subjects is a real thing to sell. The year is
/// a NUMBER rather than an FK to `academic_years` for the opposite reason: that
/// table is keyed by (system, year) and a book is usually right for both
/// systems, so pointing at one row would be a lie about the other. Neither
/// column filters anything — see `BooksService` — they only label and sort.
model Book {
  id      String @id @default(uuid(7)) @db.Uuid
  /// Citext so case cannot fork one book into two URLs — same rule as
  /// `courses.slug` and `news_posts.slug`.
  slug    String @unique @db.Citext
  titleAr String @map("title_ar")
  /// The one line under the title on the card — «شرح + أسئلة + نماذج امتحانات».
  subtitleAr String? @map("subtitle_ar")

  /// `SetNull`: retiring a subject from the taxonomy must not delete a book
  /// that is sitting in a warehouse.
  subjectId String?  @map("subject_id") @db.Uuid
  year      Int?
  term      BookTerm @default(full)

  /// The course whose printed textbook this is, when it has one. UNIQUE, so a
  /// course can never end up with two catalogue entries quoting two prices.
  /// `SetNull` — deleting a course must not delete stock.
  courseId String? @unique @map("course_id") @db.Uuid

  /// Piastres, like `courses.price_cents`. An integer and never a float:
  /// 250.50 EGP is 25050, and no amount on this table is ever the result of a
  /// binary fraction.
  priceCents        Int  @map("price_cents")
  /// What ONE copy costs ME — the other half of «مكسب الكتب إيه».
  ///
  /// Piastres, beside the price it is compared against. NULLABLE, and that is
  /// «مش معروف» rather than «مجاني»: every title that predates this column has
  /// no answer, and the margin is simply not shown for those. Defaulting it to
  /// 0 would report the whole cover price as profit, which is the one wrong
  /// answer this figure must never give.
  ///
  /// Separate from the `printing` rows in `expenses`, which record what a whole
  /// print RUN cost. A run of 500 does not tell you the cost of the single copy
  /// that just shipped, and this does.
  unitCostCents     Int? @map("unit_cost_cents")
  /// The struck-through "before" price, when there is a discount. NULL is the
  /// normal case; a value at or below `price_cents` would render a fake
  /// discount, so `books_compare_price_above_price` forbids it.
  comparePriceCents Int? @map("compare_price_cents")

  /// The storage KEY, never a full URL — same rule as media_assets (§6.7).
  coverKey      String? @map("cover_key")
  descriptionAr String? @map("description_ar")
  pageCount     Int?    @map("page_count")

  /// عام ولا لغات — the same pair, with the same CHECK, as `Course`.
  ///
  /// A property of the PRINTED OBJECT: «كتاب أولى بكالوريا لغات» is a different
  /// book from its عام twin, and a standalone title with no `courseId` has no
  /// course to borrow the answer from. Storing it here is what finally lets the
  /// shipping spreadsheet fill its «عام / لغات» column on a cart order — it read
  /// `order.course` and `book_orders.course_id` has been nullable since the shop
  /// learned to sell a basket, so the column was blank on nearly every row.
  ///
  /// Two booleans and not a third enum so `StreamBadge` and `streamChoiceOf()`
  /// read a book exactly the way they already read a course.
  forGeneral      Boolean @default(true) @map("for_general")
  forLanguages    Boolean @default(true) @map("for_languages")

  /// Where the book is ADVERTISED — never whether it can be bought.
  ///
  /// «أضيفه في الـlanding page ولا هنا ولا الاتنين.» Two independent booleans
  /// because "neither" is a real answer: a title on sale at `/books` that is not
  /// worth a slot on the front door. A three-way enum would make that state
  /// unrepresentable and push the admin to reach for `isActive`, which answers a
  /// placement question by withdrawing the product.
  ///
  /// Both are read as `isActive AND showOn*`, so unpublishing still clears every
  /// surface. `showOnCourse` is meaningless without a `courseId` and is cleared
  /// by the service when the link goes — deliberately not a CHECK, because the
  /// admin PATCH is partial and the two columns can arrive in different requests.
  showOnLanding   Boolean @default(true) @map("show_on_landing")
  showOnCourse    Boolean @default(true) @map("show_on_course")

  /// Off the shelf without deleting the row, so placed orders keep their book.
  ///
  /// ⚠️ Anything that IMPORTS books rather than having them typed must seed
  /// this `false` and let a human promote each row. The original catalogue
  /// backfill did the opposite — it published every row it created from
  /// `courses.book_title`, which on production is CTA copy rather than a name —
  /// and the shop opened with «حجز الكتاب هيتبعتلك لحد البيت» printed as the
  /// title of a 250 EGP book. See `20260902210000_books_backfill_inactive`.
  /// Publishing a guess is the mistake; an unpublished guess costs nothing.
  isActive  Boolean @default(true) @map("is_active")
  /// NULL means «مش بنعد» — the normal case for a title being reprinted. 0
  /// means genuinely out of stock and the card says so. The difference matters:
  /// a `0` default would have hidden every book the moment this column shipped.
  stock     Int?
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  course  Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  items   BookOrderItem[]

  /// The public catalogue is "active, by subject then term then sort order".
  @@index([isActive, subjectId, term, sortOrder])
  /// Print runs and anything else bought FOR this title — see `Expense`.
  expenses Expense[]

  @@map("books")
  @@schema("app")
}

/// One line on an order: which book, how many, and what it cost THAT DAY.
///
/// `titleAr` and `unitPriceCents` are SNAPSHOTS and not joins. A book that is
/// renamed, repriced or deleted must not rewrite an order already placed —
/// `bookId` is nullable and `SetNull` for the same reason, and it is also what
/// lets an admin type a line for something that is not in the catalogue at all.
model BookOrderItem {
  id      String  @id @default(uuid(7)) @db.Uuid
  orderId String  @map("order_id") @db.Uuid
  bookId  String? @map("book_id") @db.Uuid

  titleAr        String @map("title_ar")
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int

  order BookOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)

  /// One line per book per order — a second copy is `quantity`, not a second
  /// row, or the totals stop matching the card the student agreed to.
  /// ⚠️ Postgres treats NULLs as DISTINCT, so this does NOT constrain the
  /// catalogue-less lines an admin types by hand. That is intended: several
  /// «كتاب خاص» lines on one order are legitimate and there is no book for them
  /// to duplicate.
  @@unique([orderId, bookId])
  @@index([orderId])
  @@map("book_order_items")
  @@schema("app")
}

model BookOrder {
  id       String  @id @default(uuid(7)) @db.Uuid
  /// `null` for a GUEST order — ordering the physical book never required an
  /// account (Ayman: "a different service" from the platform's login-gated
  /// course content, and the course landing page is already public). When
  /// `null`, `fullName`/`phone`/`altPhone`/the address fields below are the
  /// ONLY identity this order has — they are the source of truth for
  /// shipping regardless of whether an account exists, never a fallback to
  /// `user.*`. A signed-in visitor still gets `userId` set (additive, not a
  /// removed capability) so their account's own order history keeps working.
  userId   String? @map("user_id")
  /// ⚠️ NULLABLE since the catalogue shipped, and every read must cope.
  ///
  /// Every order predating `books` came from one course's «اطلب الكتاب» button
  /// and has this set; every order from `/books` has a CART instead and leaves
  /// it null, because a basket holding a first-year book and a second-year book
  /// has no single course to name. It is kept — rather than dropped and
  /// back-filled away — so the course page's own flow still records where the
  /// order started, which is real reporting the shop cannot reconstruct.
  courseId String? @map("course_id") @db.Uuid

  /// What this order is worth in total — items + shipping − discount.
  ///
  /// Kept under its original name on purpose: `/admin/finance`'s book-revenue
  /// tile, the shipping-desk export and the admin list all read it, and it still
  /// means exactly what it meant before (what this order is worth). What changed
  /// is that it is now a SUM of the three columns below rather than one course's
  /// book price, and `book_orders_amount_is_the_sum` makes the two spellings
  /// impossible to disagree.
  ///
  /// Frozen at submit time, like `PaymentSubmission.amountCents`: an order whose
  /// books later change price still says what THIS order was worth.
  amountCents Int @map("amount_cents")

  /// The breakdown behind `amountCents`.
  ///
  /// `shippingCents` is charged ONCE per order — «مش منطقي إن يشتري ٢ ويدفع شحن
  /// مرتين»: one courier trip carries the whole basket, so the fee lives here
  /// and never on `BookOrderItem`, which makes charging it twice
  /// unrepresentable rather than merely discouraged. It is a COLUMN and not a
  /// constant read at render time so waiving it for one order is an edit rather
  /// than a deploy, and so a later price rise cannot rewrite old orders.
  ///
  /// `discountCents` is admin-only — there is no coupon field on the public
  /// form. It exists because «هخصمله ٢٠ جنيه» is a thing that happens on the
  /// phone, and recording it beats an order whose total silently disagrees with
  /// what was collected.
  itemsCents    Int @default(0) @map("items_cents")
  shippingCents Int @default(0) @map("shipping_cents")
  discountCents Int @default(0) @map("discount_cents")

  // ── The address form — step one, saved before any payment. ──
  fullName         String  @map("full_name")
  phone            String
  /// A second, alternate contact number — asked for by name, distinct from
  /// `phone`. Shipping a physical object to a real address is the one flow
  /// on this platform where "we could not reach the first number" is a
  /// routine, expected outcome, not an edge case.
  altPhone         String  @map("alt_phone")
  governorateCode  String  @map("governorate_code") @db.Char(2)
  /// Plain text, not a taxonomy lookup — no city/مدينة dataset exists for
  /// Egypt in this codebase (a full governorate→city cascade is out of
  /// scope). Shipping companies need it alongside the governorate.
  city             String
  addressStreet    String  @map("address_street")
  /// Optional — some addresses genuinely have no building number (a named
  /// house, a rural address). `null` when the student left it blank.
  addressBuilding  String? @map("address_building")
  /// Free text — anything that does not fit street/building (apartment
  /// number, floor, a landmark). `null` when the student left it blank.
  addressNote      String? @map("address_note")

  /// What an admin wrote about this order — «كلمته وقالي يبعت الأسبوع الجاي».
  ///
  /// A SECOND note column, never a shared one with `addressNote` above: that
  /// one is the customer's own words and is read back to them on the
  /// confirmation, and this one must never be. Merging them is how an internal
  /// remark ends up on a receipt.
  adminNote        String? @map("admin_note")

  // ── The payment step — step two. `null` until submitted. ──
  /// The Vodafone Cash number the transfer was sent FROM — same convention
  /// as `PaymentSubmission.senderPhone`.
  senderPhone   String? @map("sender_phone")
  /// The storage KEY of the uploaded screenshot — same convention as
  /// `PaymentSubmission.screenshotKey`, served only through the gated admin
  /// route, never the public `/media/:prefix/:name` path.
  screenshotKey String? @map("screenshot_key")
  /// Set the moment the screenshot is submitted — see the model doc for why
  /// this alone is what "paid" means for a book order.
  paidAt        DateTime? @map("paid_at")

  status BookOrderStatus @default(address_only)

  /// «اتشحن» — set by `BookOrdersService.markShipped`, an explicit admin
  /// action. Records ONLY that the order shipped; no notification is sent to
  /// the student (the admin handles that himself, outside the platform).
  shippedAt       DateTime? @map("shipped_at")
  shippedByUserId String?   @map("shipped_by_user_id")

  /// «وصل» — the courier handed it over. A FOURTH state and not a flag beside
  /// `shippedAt`, because `shipped` is the last thing the PLATFORM knew and this
  /// is the last thing that HAPPENED: a book sits with a courier for days and
  /// only the student learns it arrived. The transition is what fires
  /// `book_order_delivered`, and `deliveredByUserId` answers «مين قال إنه وصل»
  /// on the day it turns out it did not.
  deliveredAt       DateTime? @map("delivered_at")
  deliveredByUserId String?   @map("delivered_by_user_id")

  /// «أرفضه» — the admin turned the order down, and the student is owed the
  /// reason. The row STAYS in the list and stays visible to the student; that is
  /// the whole difference from `deletedAt` below. `books_orders_rejection_has_a_
  /// reason` makes the explanation mandatory, because a rejection nobody
  /// explained is a support call, and `book_orders_rejected_status_matches` stops
  /// the status and the timestamp from ever disagreeing.
  rejectedAt       DateTime? @map("rejected_at")
  rejectedByUserId String?   @map("rejected_by_user_id")
  rejectionReason  String?   @map("rejection_reason")

  /// «أحذفه وأكتب سبب الحذف» — gone from the working list, still in the table.
  ///
  /// NOT a status: an order can be deleted from any state, and folding it into
  /// `status` would lose the state it was deleted FROM. Soft, decided
  /// explicitly — «واحد دفع فلوس»: the row is money that was received and is
  /// counted in «إيرادات الكتب», so a real DELETE would restate a month's
  /// revenue with nothing left to explain the difference, and could not be
  /// undone by whoever clicked the wrong row. Every read filters
  /// `deletedAt: null`; one admin filter shows them again, and one action puts
  /// a row back.
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id")
  deletionReason  String?   @map("deletion_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User?       @relation("BookOrderStudent", fields: [userId], references: [id], onDelete: Cascade)
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  shippedBy    User?       @relation("BookOrderShippedBy", fields: [shippedByUserId], references: [id], onDelete: SetNull)
  deliveredBy  User?       @relation("BookOrderDeliveredBy", fields: [deliveredByUserId], references: [id], onDelete: SetNull)
  rejectedBy   User?       @relation("BookOrderRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  deletedBy    User?       @relation("BookOrderDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  governorate  Governorate @relation(fields: [governorateCode], references: [code])
  items        BookOrderItem[]

  /// The admin list: paid-not-yet-shipped is the default view of `/admin/books`
  /// and the Excel export's own filter — oldest first, first-come-first-served,
  /// same convention as the payment review queue.
  @@index([status, createdAt])
  /// "Has this student got an order already sitting for this course" — not
  /// enforced as a hard uniqueness constraint (a lost book is a real reason
  /// to order a second one), but this is the lookup the create endpoint's
  /// own duplicate-address-only-row reuse runs.
  @@index([userId, courseId, status])
  @@index([governorateCode])
  @@map("book_orders")
  @@schema("app")
}

enum BookOrderStatus {
  address_only
  paid
  shipped
  delivered
  rejected

  @@map("book_order_status")
  @@schema("app")
}

/// RECONCILED — this is the union of Plan 3's and Plan 4's drafts, declared
/// once, here. Plan 4 Task 2 adds ONLY the `progress LessonProgress[]`
/// back-relation to it; it does not re-declare the model and it does not
/// ALTER TABLE it.
///
/// `progressPercent` is DERIVED — completed published lessons ÷ published
/// lessons × 100 — recomputed by Plan 4's `CourseProgressService.recalculate`
/// only on a completion transition, never on a heartbeat. It is 0 until Plan 4
/// lands, which is correct and not a bug.
model Enrollment {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @map("user_id")
  courseId        String           @map("course_id") @db.Uuid
  source          EnrollmentSource @default(free)
  status          EnrollmentStatus @default(active)
  enrolledAt      DateTime         @default(now()) @map("enrolled_at")
  expiresAt       DateTime?        @map("expires_at")
  completedAt     DateTime?        @map("completed_at")
  progressPercent Decimal          @default(0) @map("progress_percent") @db.Decimal(5, 2)
  /// Powers resume + continue-watching (Plan 4). Written on every lesson open.
  lastLessonId    String?          @map("last_lesson_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastLesson Lesson?          @relation("EnrollmentLastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)
  /// Plan 4 Task 2's own back-relation — the only field this task adds to Enrollment.
  progress   LessonProgress[]
  /// Slice 3's back-relation. See `LessonViewSession` for why the timeline
  /// needs a table of its own rather than more columns on `LessonProgress`.
  viewSessions LessonViewSession[]

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@map("enrollments")
  @@schema("app")
}

// ── Plan 4: lesson progress ──────────────────────────────────────────────
// Task 2. The ONE new model this plan declares — Enrollment and AccessGrant
// above are Plan 3's, unchanged except for the `progress` back-relation.

/// Keeps earned completions separable from claimed ones forever. A single
/// boolean would blend "watched 95% of the video" with "pressed the button
/// after 3 seconds" and there would be no way to unpick it later.
enum CompletionSource {
  auto
  manual
  dwell

  @@map("completion_source")
  @@schema("app")
}

enum LessonProgressState {
  not_started
  in_progress
  completed
  passed
  failed

  @@map("lesson_progress_state")
  @@schema("app")
}

/// §6.6. Note the composite primary key rather than a surrogate `id`: this
/// table is only ever addressed as (enrollment, lesson), the pair is already
/// UNIQUE, and dropping the surrogate lets the heartbeat's
/// `SELECT … FOR UPDATE` path run without generating a uuid7 outside Prisma's
/// client — which raw SQL cannot do for us.
///
/// `completion` is `numeric(5,4)` (0..1) so partial video progress survives a
/// reload; `watchedSeconds` and `maxPositionSeconds` are the two independent
/// signals the completion rule needs, and neither is ever written from a
/// client-supplied total.
model LessonProgress {
  enrollmentId       String              @map("enrollment_id") @db.Uuid
  lessonId           String              @map("lesson_id") @db.Uuid
  completion         Decimal             @default(0) @db.Decimal(5, 4)
  state              LessonProgressState @default(not_started)
  watchedSeconds     Int                 @default(0) @map("watched_seconds")
  maxPositionSeconds Int                 @default(0) @map("max_position_seconds")
  openCount          Int                 @default(0) @map("open_count")
  /// Set once, on the first open. The 5000ms dwell rule measures against THIS,
  /// server-side, so no client-reported dwell duration is ever trusted.
  firstOpenedAt      DateTime?           @map("first_opened_at")
  /// The wall-clock anchor for heartbeat accumulation. Separate from
  /// `updatedAt` because `updatedAt` is rewritten by every unrelated write.
  lastHeartbeatAt    DateTime?           @map("last_heartbeat_at")
  completedAt        DateTime?           @map("completed_at")
  completedVia       CompletionSource?   @map("completed_via")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, lessonId])
  @@index([lessonId])
  @@index([enrollmentId, state])
  @@map("lesson_progress")
  @@schema("app")
}

/// One SITTING at a lesson — not one heartbeat.
///
/// `LessonProgress` above stores totals: `watchedSeconds` says how much of
/// this lesson the student has ever watched, `openCount` how many times they
/// opened it. Neither can answer "when did they watch, and for how long THAT
/// time", which is the question the profile timeline exists to answer. No
/// arrangement of columns on a one-row-per-(enrollment, lesson) table can:
/// the fact being recorded is one-to-many.
///
/// Rows are created by sessionisation on write, in `HeartbeatService.record`:
/// a heartbeat extends the open session for its pair when one was last seen
/// within `VIEW_SESSION_GAP_SECONDS`, and starts a new row otherwise. A
/// heartbeat fires every 10s, so a 40-minute lesson is 240 of them —
/// one row each would be millions of rows behind a screen that wants to say
/// "شُفت الدرس ده الساعة ٩ ونص لمدة ١٢ دقيقة".
///
/// `watchedSeconds` credits the SERVER-GRANTED delta
/// (`allowedHeartbeatSeconds`), never the client's claim. The whole
/// anti-forgery control on `lesson_progress.watched_seconds` has to hold here
/// too, or the timeline becomes the softer number worth lying to.
///
/// No `userId` column: it is reachable through `enrollment`, and duplicating
/// it would be a second place for ownership to be wrong. Every read filters
/// on the enrollment's owner.
model LessonViewSession {
  id             String   @id @default(uuid(7)) @db.Uuid
  enrollmentId   String   @map("enrollment_id") @db.Uuid
  lessonId       String   @map("lesson_id") @db.Uuid
  startedAt      DateTime @map("started_at")
  /// Also the sessionisation key: the gap is measured against this.
  lastSeenAt     DateTime @map("last_seen_at")
  watchedSeconds Int      @default(0) @map("watched_seconds")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// The timeline's only query shape: this student's sittings, newest first.
  /// The descending sort is part of the index so the feed never sorts.
  @@index([enrollmentId, startedAt(sort: Desc)])
  /// Serves the sessionisation lookup, which filters on the pair.
  @@index([enrollmentId, lessonId, lastSeenAt(sort: Desc)])
  @@index([lessonId])
  @@map("lesson_view_sessions")
  @@schema("app")
}

// ═══════════════════════════════════════════════════════════════════════
// Plan 5 — Quiz engine: question bank (Task 1)
// ═══════════════════════════════════════════════════════════════════════

enum QuestionType {
  mcq_single
  mcq_multi
  true_false
  short_answer
  /// The options ARE the answer: `question_options.position` order is the
  /// correct sequence, and `attempt_questions.option_order` is always
  /// shuffled for this type regardless of the quiz's own shuffle setting —
  /// serving the stored order would be serving the answer key.
  ordering
  essay

  @@schema("app")
}

enum QuestionStatus {
  draft
  ready
  hidden

  @@schema("app")
}

/// v1 is one instructor, one subject, so every category is `global` (spec §1).
/// The enum exists so a future multi-teacher build is a data change, not a
/// migration of every existing row.
enum QuestionOwnerScope {
  global
  instructor
  course

  @@schema("app")
}

/// A folder in the bank. Self-referencing so the admin can nest
/// "الوحدة الأولى → الحلقات التكرارية → for".
model QuestionCategory {
  id         String             @id @default(uuid(7)) @db.Uuid
  parentId   String?            @map("parent_id") @db.Uuid
  ownerScope QuestionOwnerScope @default(global) @map("owner_scope")
  ownerId    String?            @map("owner_id")
  name       String
  sortOrder  Int                @default(0) @map("sort_order")
  createdAt  DateTime           @default(now()) @map("created_at")

  parent   QuestionCategory?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children QuestionCategory[]  @relation("CategoryTree")
  entries  QuestionBankEntry[]

  @@index([parentId])
  @@map("question_categories")
  @@schema("app")
}

/// The stable identity of a question across all its versions. Quiz slots and
/// analytics point at the ENTRY; attempts point at a VERSION.
model QuestionBankEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  /// Reserved for a future QTI import/export. `{option, fraction}` already
  /// makes the schema QTI-shaped; this is the identifier column QTI needs.
  externalRef String?  @map("external_ref")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category  QuestionCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions  QuestionVersion[]
  quizSlots QuizSlot[]

  @@index([categoryId])
  @@map("question_bank_entries")
  @@schema("app")
}

/// IMMUTABLE ONCE `status = 'ready'`. Editing a ready question creates
/// version N+1 in `draft`; publishing flips it to `ready`. This is the whole
/// reason `attempt_questions.question_version_id` can be trusted years later:
/// without it, fixing a typo in a stem silently rewrites the review screen of
/// every attempt anyone ever made. A database trigger (Step 3) enforces the
/// immutability — a service-layer rule alone would be one forgotten
/// `prisma.questionVersion.update` away from data loss.
model QuestionVersion {
  id                  String         @id @default(uuid(7)) @db.Uuid
  bankEntryId         String         @map("bank_entry_id") @db.Uuid
  version             Int
  status              QuestionStatus @default(draft)
  type                QuestionType
  stemHtml            String         @map("stem_html")
  generalFeedbackHtml String?        @map("general_feedback_html")
  defaultMark         Decimal        @default(1) @map("default_mark") @db.Decimal(10, 4)
  /// Reserved: Moodle's per-attempt penalty for interactive-with-multiple-tries.
  /// v1 always writes 0 and the grader ignores it — see "Deliberately not".
  penalty             Decimal        @default(0) @db.Decimal(10, 4)
  /// { shuffleOptions, caseSensitive, minWords, maxWords, graderInfo }.
  /// `graderInfo` is INSTRUCTOR-ONLY and must never reach a learner payload —
  /// which is why the learner select projects `settings` field by field
  /// instead of passing the jsonb through (Task 9).
  settings            Json           @default("{}")
  createdBy           String         @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")

  bankEntry        QuestionBankEntry @relation(fields: [bankEntryId], references: [id], onDelete: Cascade)
  author           User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  options          QuestionOption[]
  attemptQuestions AttemptQuestion[]

  @@unique([bankEntryId, version])
  @@index([bankEntryId, status])
  @@map("question_versions")
  @@schema("app")
}

/// The scoring primitive. `fraction` is a numeric weight that MAY BE NEGATIVE
/// (per-option negative marking) — there is deliberately no `is_correct`
/// boolean anywhere in this schema. Partial credit and negative marking are
/// therefore free, and a QTI exporter is a serializer, not a migration.
///
/// For `short_answer`, `bodyHtml` is '' and `answerPattern` holds the raw
/// match pattern. The pattern must NOT go through sanitize-html: HTML-encoding
/// `<` would silently break a pattern like `a < b`, and the review screen
/// renders it as text, never as HTML.
model QuestionOption {
  id                String  @id @default(uuid(7)) @db.Uuid
  questionVersionId String  @map("question_version_id") @db.Uuid
  bodyHtml          String  @map("body_html")
  answerPattern     String? @map("answer_pattern")
  fraction          Decimal @db.Decimal(10, 6)
  feedbackHtml      String? @map("feedback_html")
  position          Int

  version QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)

  @@unique([questionVersionId, position])
  @@map("question_options")
  @@schema("app")
}

// ═══════════════════════════════════════════════════════════════════════
// Plan 5 — Quiz engine: quiz, slots and pools (Task 2)
// ═══════════════════════════════════════════════════════════════════════

/// Which of a quiz's two papers a slot belongs to, and which one an attempt
/// was drawn from.
///
/// The improvement sitting (تحسين) is a SECOND PAPER on the SAME quiz, never a
/// second quiz. `quizzes.lesson_id` is unique and an exam is a lesson, so a
/// separate improvement quiz would have to be a separate lesson — and that
/// creates a second "the student's exam score" that can drift from the first.
/// One quiz, two papers keeps one score, one gate rule and one grading path.
enum QuizPaper {
  original
  improvement

  @@map("quiz_paper")
  @@schema("app")
}

enum OverdueHandling {
  autosubmit
  graceperiod
  autoabandon

  @@schema("app")
}

enum NavMethod {
  free
  sequential

  @@schema("app")
}

model Quiz {
  id              String    @id @default(uuid(7)) @db.Uuid
  lessonId        String    @unique @map("lesson_id") @db.Uuid
  durationSeconds Int?      @map("duration_seconds")
  openFrom        DateTime? @map("open_from")
  openUntil       DateTime? @map("open_until")

  /// Offers ONE extra sitting, drawn from the `improvement` paper, with the
  /// HIGHER of the two scores counting. Only ever true on a course's final
  /// exam — `QuizBuilderService` refuses to set it on any other lesson.
  ///
  /// This one boolean replaced `mode`, `max_attempts`, `grade_method` and
  /// `retry_cooldown_hours`. Between them those four could express "unlimited
  /// attempts, 0h apart, last one counts, answers revealed mid-attempt", and
  /// three of the four DEFAULTED that way: `max_attempts = 0` meant unlimited
  /// and `mode = practice` meant instant feedback. A quiz built by clicking
  /// through the form was one a student could sit until they had memorised the
  /// paper. The allowance is now a rule in code — `attemptAllowance()`, one
  /// sitting or two — and nothing in the database can widen it.
  allowsImprovement Boolean @default(false) @map("allows_improvement")

  passPercent      Decimal         @default(70) @map("pass_percent") @db.Decimal(5, 2)
  shuffleQuestions Boolean         @default(false) @map("shuffle_questions")
  shuffleOptions   Boolean         @default(true) @map("shuffle_options")
  overdueHandling  OverdueHandling @default(autosubmit) @map("overdue_handling")
  graceSeconds     Int             @default(60) @map("grace_seconds")
  navMethod        NavMethod       @default(free) @map("nav_method")
  /// The 4-window × 7-flag matrix. Resolved SERVER-SIDE (Task 13); the
  /// disallowed fields are stripped in the serializer, never hidden in CSS.
  reviewOptions    Json            @map("review_options")

  /// Denormalised sum of slot maxMarks PER PAPER, recomputed on every slot
  /// write so the runner never has to aggregate to show "من 20". Two columns
  /// rather than one because the two papers are marked independently and a
  /// single total would be the sum of an exam nobody sits.
  sumMarks            Decimal @default(0) @map("sum_marks") @db.Decimal(10, 4)
  improvementSumMarks Decimal @default(0) @map("improvement_sum_marks") @db.Decimal(10, 4)

  gradeOutOf  Decimal  @default(100) @map("grade_out_of") @db.Decimal(10, 4)
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lesson   Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  slots    QuizSlot[]
  pools    QuizPool[]
  attempts QuizAttempt[]

  @@map("quizzes")
  @@schema("app")
}

/// One question position on the paper. Either it points at a bank entry
/// (a fixed question) or at a pool (draw N at random at attempt creation) —
/// never both, never neither. `pinnedVersion = NULL` means "latest ready
/// version at the moment the attempt starts", which is then snapshotted onto
/// attempt_questions and never re-resolved.
model QuizSlot {
  id              String    @id @default(uuid(7)) @db.Uuid
  quizId          String    @map("quiz_id") @db.Uuid
  /// Which paper this position belongs to. Numbering restarts per paper, so
  /// both papers have a question 1.
  paper           QuizPaper @default(original)
  position        Int
  page            Int       @default(0)
  bankEntryId     String?   @map("bank_entry_id") @db.Uuid
  pinnedVersion   Int?      @map("pinned_version")
  poolId          String?   @map("pool_id") @db.Uuid
  maxMark         Decimal   @map("max_mark") @db.Decimal(10, 4)
  requirePrevious Boolean   @default(false) @map("require_previous")

  quiz      Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  bankEntry QuestionBankEntry? @relation(fields: [bankEntryId], references: [id], onDelete: Restrict)
  pool      QuizPool?          @relation(fields: [poolId], references: [id], onDelete: Cascade)

  // NOTE: this unique is redefined as DEFERRABLE in the hand-written migration.
  // Prisma cannot express DEFERRABLE, and without it a drag-reorder has to
  // write in two phases to dodge transient collisions. `paper` is part of the
  // key, so rebuilding it deferrable is not optional when the column is added
  // — a non-deferrable replacement silently breaks reordering.
  @@unique([quizId, paper, position])
  @@index([poolId])
  @@map("quiz_slots")
  @@schema("app")
}

/// "Pick 5 at random from تصنيف الحلقات التكرارية." The draw happens once, at
/// attempt creation, and the drawn versions are snapshotted — a resumed
/// attempt never redraws.
model QuizPool {
  id                String    @id @default(uuid(7)) @db.Uuid
  quizId            String    @map("quiz_id") @db.Uuid
  /// The paper this pool draws for. Enforced to match its slots' `paper` by a
  /// CHECK-backed composite FK in the migration, so a pool cannot feed the
  /// improvement paper from the original's slots.
  paper             QuizPaper @default(original)
  name              String
  pickCount         Int       @map("pick_count")
  pointsPerQuestion Decimal   @map("points_per_question") @db.Decimal(10, 4)
  /// { categoryIds: string[], types: QuestionType[] }
  sourceFilter      Json      @map("source_filter")

  quiz  Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  slots QuizSlot[]

  // Backs `quiz_slots_pool_paper_matches` — the composite FK the migration
  // adds so a slot's `paper` structurally has to match its pool's. Declaring
  // the unique half here keeps `migrate dev`'s drift check quiet about it;
  // Prisma has no way to express the composite FK itself (it is not a modelled
  // relation), so that half stays invisible to Prisma and must never be
  // "corrected" away. Same arrangement as `course_sections_id_course_key`.
  @@unique([id, paper], map: "quiz_pools_id_paper_key")
  @@map("quiz_pools")
  @@schema("app")
}

// ═══════════════════════════════════════════════════════════════════════
// Plan 5 — Quiz engine: attempts and the append-only event log (Task 3)
// ═══════════════════════════════════════════════════════════════════════

enum AttemptState {
  in_progress
  overdue
  submitted
  pending_review
  abandoned

  @@schema("app")
}

/// `todo` / `complete` describe ANSWERING; the four `graded_*` values describe
/// GRADING. A learner payload never carries this column — it is projected to a
/// plain `answered: boolean` in the serializer, because `graded_right` leaking
/// into a pre-submission response is exactly the leak class Q1 exists to stop.
enum AttemptQuestionState {
  todo
  complete
  needs_grading
  graded_right
  graded_partial
  graded_wrong

  @@schema("app")
}

enum AttemptEventKind {
  attempt_started
  question_viewed
  answer_saved
  answer_cleared
  flag_toggled
  answer_checked
  submitted
  autosubmitted
  abandoned
  graded
  regraded
  /// RETIRED. Appeals (التظلمات) were removed with the `grade_appeals` table;
  /// nothing writes these two any more.
  ///
  /// They stay in the enum on purpose. `attempt_events` is append-only with
  /// UPDATE and DELETE revoked from `ayman_runtime` at the database level, and
  /// Postgres has no `ALTER TYPE … DROP VALUE` — removing them would mean
  /// recreating the type under a log whose whole value is that it cannot be
  /// rewritten. A dead enum label costs nothing; a rewritable audit log does.
  appeal_opened
  appeal_resolved
  extra_time_granted
  extra_attempt_granted
  attempt_reopened
  stale_write_rejected

  @@schema("app")
}

model QuizAttempt {
  id        String       @id @default(uuid(7)) @db.Uuid
  quizId    String       @map("quiz_id") @db.Uuid
  userId    String       @map("user_id")
  attemptNo Int          @map("attempt_no")
  /// Which paper this sitting drew from. PERSISTED AT START AND NEVER
  /// RECOMPUTED, for exactly the reason `deadlineAt` and `sumMarks` below are:
  /// an instructor rebuilding either paper must not retroactively change which
  /// exam a student already sat. Derived once from `attemptNo` — the first
  /// sitting is the original, the second is the improvement.
  paper     QuizPaper    @default(original)
  state     AttemptState @default(in_progress)
  startedAt DateTime     @default(now()) @map("started_at")
  /// PERSISTED AT START AND NEVER RECOMPUTED. An instructor editing
  /// `durationSeconds` must not shorten or extend an in-flight attempt.
  /// Accommodation is ADDITIVE via extraTimeSeconds — still never a recompute.
  deadlineAt       DateTime?    @map("deadline_at")
  submittedAt      DateTime?    @map("submitted_at")
  lastActivityAt   DateTime     @default(now()) @map("last_activity_at")
  /// Required on every write. Rotated on an explicit resume, which is what
  /// makes it kill a stale tab left open on another device.
  attemptToken     String       @default(uuid(7)) @map("attempt_token") @db.Uuid
  rawScore         Decimal?     @map("raw_score") @db.Decimal(10, 4)
  scaledScore      Decimal?     @map("scaled_score") @db.Decimal(10, 4)
  passed           Boolean?
  extraTimeSeconds Int          @default(0) @map("extra_time_seconds")
  /// Admin grant of a sitting beyond the ordinary allowance.
  ///
  /// NOT a retake: a student cannot ask for one and no UI offers it. It exists
  /// for the case the allowance rule has no answer for — a connection that
  /// died mid-exam — and without it the only remedy is a hand-written UPDATE
  /// against production. Additive across the user's attempts on this quiz and
  /// written through an audited grant, so it is a record rather than a mutable
  /// counter.
  extraAttempts    Int          @default(0) @map("extra_attempts")
  /// B7 — PERSISTED AT START AND NEVER RECOMPUTED, exactly like `deadlineAt`
  /// above. `sumMarks` is derived from what `resolveSlots` ACTUALLY resolved
  /// (not the quiz's live, editable total), so a fixed slot skipped for
  /// having no ready version, or a pool that under-fills its `pickCount`,
  /// self-corrects the denominator instead of inflating it. Without this
  /// snapshot, an instructor adding/removing a slot — or editing the grade
  /// settings — while a student is mid-attempt silently rescales their score
  /// (a perfect paper could fail), and re-marking an essay months later would
  /// rescale the original attempt against whatever the quiz looks like today.
  sumMarks         Decimal      @map("sum_marks") @db.Decimal(10, 4)
  gradeOutOf       Decimal      @map("grade_out_of") @db.Decimal(10, 4)
  passPercent      Decimal      @map("pass_percent") @db.Decimal(5, 2)

  quiz      Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions AttemptQuestion[]
  events    AttemptEvent[]

  @@unique([quizId, userId, attemptNo])
  @@index([quizId, state])
  @@index([userId, quizId])
  @@index([state, deadlineAt])
  @@map("quiz_attempts")
  @@schema("app")
}

/// The mutable half of the hybrid store: one row per question per attempt, so
/// the results screen is a single join. `questionVersionId` and `optionOrder`
/// are SNAPSHOTS taken at attempt creation and are never re-derived.
model AttemptQuestion {
  id                String               @id @default(uuid(7)) @db.Uuid
  attemptId         String               @map("attempt_id") @db.Uuid
  slotPosition      Int                  @map("slot_position")
  questionVersionId String               @map("question_version_id") @db.Uuid
  /// Permutation of the version's option `position` values, captured once.
  /// Without it, resume-after-disconnect reshuffles the paper and the student
  /// re-reads four options they had already eliminated.
  optionOrder       Int[]                @map("option_order")
  maxMark           Decimal              @map("max_mark") @db.Decimal(10, 4)
  minFraction       Decimal              @map("min_fraction") @db.Decimal(10, 6)
  maxFraction       Decimal              @map("max_fraction") @db.Decimal(10, 6)
  /// { kind: 'choice', optionIds: string[] } | { kind: 'text', text: string }
  response          Json?
  /// Monotonic client sequence. A late autosave from a backgrounded tab cannot
  /// overwrite a newer answer, because the UPDATE carries `response_seq < $seq`.
  responseSeq       Int                  @default(0) @map("response_seq")
  fraction          Decimal?             @db.Decimal(10, 6)
  mark              Decimal?             @db.Decimal(10, 4)
  state             AttemptQuestionState @default(todo)
  flagged           Boolean              @default(false)
  /// Written at SUBMIT time only, so it cannot leak before then.
  rightAnswerText   String?              @map("right_answer_text")
  responseText      String?              @map("response_text")
  answeredAt        DateTime?            @map("answered_at")
  gradedAt          DateTime?            @map("graded_at")
  gradedBy          String?              @map("graded_by")
  feedbackHtml      String?              @map("feedback_html")

  attempt QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  version QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  grader  User?           @relation("AttemptQuestionGrader", fields: [gradedBy], references: [id], onDelete: SetNull)

  @@unique([attemptId, slotPosition])
  @@index([questionVersionId])
  @@map("attempt_questions")
  @@schema("app")
}

/// The append-only half. UPDATE and DELETE are REVOKED from ayman_runtime at
/// the database level (Step 3), exactly like audit_log. `seq` is gap-free per
/// attempt, so a missing number is itself evidence.
model AttemptEvent {
  id                BigInt           @id @default(autoincrement())
  attemptId         String           @map("attempt_id") @db.Uuid
  attemptQuestionId String?          @map("attempt_question_id") @db.Uuid
  seq               Int
  kind              AttemptEventKind
  payload           Json             @default("{}")
  actorId           String?          @map("actor_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, seq])
  @@index([attemptId, createdAt])
  @@map("attempt_events")
  @@schema("app")
}

// ── Platform configuration (spec §6.7, Plan 6) ────────────────────────────

/// Singleton. `id` is fixed at 1 and enforced by a CHECK constraint in the
/// migration — Sanity's documented failure mode is duplicate settings
/// documents, after which "the settings" is whichever row the query happened
/// to return first. `data` is a jsonb blob validated by SiteSettingsSchema in
/// packages/contracts on the way in and on the way out; keeping it as jsonb
/// means adding a settings field is a schema change in TypeScript, not a
/// migration.
model SiteSetting {
  id        Int      @id @default(1)
  data      Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
  @@schema("app")
}

/// Flag *declarations* live in TypeScript (typed, greppable). This table holds
/// only the VALUES, so a flag nobody declared is inert rather than dangerous.
model FeatureFlag {
  key           String   @id
  descriptionAr String   @map("description_ar")
  enabled       Boolean  @default(false)
  rollout       Json?
  updatedBy     String?  @map("updated_by")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
  @@schema("app")
}

/// The menu builder's tree. `position` is an int with an id tie-break, never a
/// CSV sequence column. `visibleTo` holds permission strings, not role names.
model NavigationItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  labelAr     String    @map("label_ar")
  href        String
  icon        String?
  position    Int
  visibleTo   String[]  @default([]) @map("visible_to")
  isPublished Boolean   @default(true) @map("is_published")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent   NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavTree")

  @@index([parentId, position])
  @@map("navigation_items")
  @@schema("app")
}

/// ⚠️ Kept in lockstep with `HOME_BLOCK_TYPES` in
/// `packages/contracts/src/admin/home-blocks.ts`. `HomeBlocksService.create`
/// writes `props.type` directly into this column, so a variant that exists in
/// the contracts union and not here fails at INSERT with a Postgres enum
/// error rather than a validation message.
/// What a spend was FOR. The buckets Ayman named, plus the two every ledger
/// grows within a month of existing (`services`, `staff`) and a catch-all.
///
/// An enum and not free text: the whole point of the column is that October's
/// «تصوير» and November's «تصوير» add up, which they do not when one of them
/// was typed «التصوير».
enum ExpenseCategory {
  /// التصوير والاستوديو
  filming
  /// المطبعة
  printing
  /// أدوات ومعدات — قلم، تابلت، لابتوب
  equipment
  /// إعلانات
  marketing
  /// أجور ومساعدين
  staff
  /// اشتراكات وخدمات — سيرفرات، برامج
  services
  other

  @@map("expense_category")
  @@schema("app")
}

/// One thing Ayman paid for. The half of `/admin/finance` that did not exist:
/// the screen could say what came in and nothing about what went out, so
/// «صرفت كام ودخلي كام» was not answerable anywhere on the platform.
///
/// ## `occurredOn` is a DATE, and it is not `createdAt`
///
/// The month the money left, versus the moment somebody typed it in. Entering
/// last month's studio invoice today has to land in last month's total or every
/// month closes wrong as soon as data entry lags by a day. A DATE and not a
/// timestamp because nobody records the minute they paid the printer, and a
/// timestamp would invite a timezone bug into a number that is only ever
/// bucketed by month.
///
/// ## `bookId` + `quantity`
///
/// A print run's whole meaning is which title it bought and how many copies —
/// «اشتريت عشر كتب بكذا». Both nullable (a tablet has no book), and
/// `expenses_book_needs_quantity` refuses the half-stated version. `SetNull` on
/// the book, because retiring a title must not delete money that was spent.
model Expense {
  id          String          @id @default(uuid(7)) @db.Uuid
  occurredOn  DateTime        @map("occurred_on") @db.Date
  category    ExpenseCategory
  /// Piastres, always positive — a refund is its own thing, not a minus sign
  /// that silently flips every SUM on the page. See the migration.
  amountCents Int             @map("amount_cents")
  /// What it was, in the admin's own words. Required: an unlabelled number in a
  /// ledger is one nobody can audit six months later.
  titleAr     String          @map("title_ar") @db.VarChar(160)
  noteAr      String?         @map("note_ar")
  bookId      String?         @map("book_id") @db.Uuid
  quantity    Int?
  createdBy   String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  book    Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)
  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([occurredOn(sort: Desc), category])
  @@index([bookId])
  @@map("expenses")
  @@schema("app")
}

enum HomeBlockType {
  hero
  whyRail
  courseGrid
  /// «قسم الكتب» — the shop's strip on the landing page.
  books
  instructor
  yearTracks
  about
  stats
  testimonials
  faq
  cta

  @@map("home_block_type")
  @@schema("app")
}

/// The homepage composer. `props` is validated by the HomeBlockSchema
/// discriminated union (Task 15) — the union discriminant is this `type`
/// column, so a row can never carry props from a different block type.
model HomeBlock {
  id          String        @id @default(uuid(7)) @db.Uuid
  key         String        @unique
  type        HomeBlockType
  props       Json
  position    Int
  isPublished Boolean       @default(false) @map("is_published")
  archivedAt  DateTime?     @map("archived_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([position])
  @@map("home_blocks")
  @@schema("app")
}

enum NewsStatus {
  draft
  published

  @@map("news_status")
  @@schema("app")
}

/// «نيوز» — the public articles section: evergreen teaching content about
/// programming, written for search.
///
/// The catalog ranks for people who already know the platform. This ranks for
/// «إيه هي الحلقة التكرارية» — a student who has never heard of it, asking a
/// search engine or an assistant. Every article ends on `relatedCourse`, which
/// is the point: the traffic has somewhere to go.
///
/// Named "news" but evergreen by design. Exam dates and curriculum decisions
/// go stale and get republished wrong; a teacher's own site carrying a wrong
/// date costs more trust than the traffic is worth. Programming does not
/// change by decree.
model NewsPost {
  id      String     @id @default(uuid(7)) @db.Uuid
  /// Arabic slugs are normal here — a percent-encoded UTF-8 path is handled
  /// fine by search engines, and an Arabic query matching an Arabic URL is a
  /// signal a transliterated slug throws away. Citext so case cannot fork one
  /// article into two URLs.
  slug    String     @unique @db.Citext
  title   String
  /// ⚠️ ONE field doing three jobs on purpose: the card blurb, the list
  /// excerpt, AND the meta description. Separate fields drift, and the one
  /// that silently rots is always the meta description.
  excerpt String
  /// Markdown, rendered into React elements by `apps/web/lib/news/markdown.ts`
  /// — never dangerouslySetInnerHTML. Author-supplied text on a public page is
  /// an XSS sink the moment raw HTML is allowed through.
  body    String
  status  NewsStatus @default(draft)

  /// The storage KEY, never a full URL — same rule as media_assets (§6.7).
  coverKey String? @map("cover_key")

  /// The conversion path. `SetNull` so unpublishing a course leaves the
  /// article standing without its CTA rather than deleting the article.
  relatedCourseId String? @map("related_course_id") @db.Uuid

  authorId String @map("author_id")

  /// Set once, on first publish. `updatedAt` moves on every edit and would
  /// make an old article look new to a crawler on every typo fix — the two are
  /// NOT interchangeable in the sitemap or in JSON-LD.
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author        User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  relatedCourse Course? @relation(fields: [relatedCourseId], references: [id], onDelete: SetNull)

  /// The public list is "published, newest first" on a cacheable page, so it
  /// gets a covering index rather than a sort in memory.
  @@index([status, publishedAt(sort: Desc)])
  @@map("news_posts")
  @@schema("app")
}

/// Stores the storage KEY, never a full URL. The URL is reconstructed from
/// the media origin at render time, so moving to S3/R2 changes one env var
/// rather than rewriting every row.
model MediaAsset {
  id         String    @id @default(uuid(7)) @db.Uuid
  storageKey String    @unique @map("storage_key")
  filename   String
  mime       String
  sizeBytes  Int       @map("size_bytes")
  width      Int?
  height     Int?
  altAr      String?   @map("alt_ar")
  uploadedBy String?   @map("uploaded_by")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// Campaigns that attach this image. `SetNull` on the far side — archiving
  /// an asset must not delete the campaign that used it.
  marketingCampaigns MarketingCampaign[]

  @@index([createdAt])
  @@map("media_assets")
  @@schema("app")
}

/// What happened to one student that they should be told about.
///
/// Slice 4. Deliberately IN-APP ONLY: there is no delivery column, no
/// provider, no retry state and no per-channel status, because nothing is ever
/// sent anywhere. A row appearing here IS the notification.
///
/// ⚠️ There is no `message` column, on purpose. Storing rendered Arabic prose
/// would make every wording fix a data migration, and would put user-facing
/// copy outside `@ayman/contracts/copy` — where Global Constraint 4 requires
/// it to live. `payload` carries ids and numbers; the client composes the
/// sentence from `kind` + the copy table.
///
/// Every kind here is a PER-STUDENT event on an existing code path. Anything
/// that fans out ("a new course was published" — one row per enrolled
/// student) is deliberately absent: at a few thousand students that is a write
/// amplification problem and a mark-all-read problem at once, and it deserves
/// its own design rather than being smuggled in here.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id")
  kind      NotificationKind
  payload   Json             @default("{}")
  /// Nullable rather than a boolean, matching every other soft-state column in
  /// this schema (`archivedAt`, `revokedAt`, `completedAt`): it records WHEN,
  /// which a boolean throws away for no saving.
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The list: this student's notifications, newest first, straight off the
  /// index with no sort.
  @@index([userId, createdAt(sort: Desc)])
  /// The badge count — the most frequent query this table will ever take,
  /// once per page load for every signed-in student.
  @@index([userId, readAt])
  @@map("notifications")
  @@schema("app")
}

/// A browser's Web Push subscription — what `PushService.notifyUser` sends
/// to, and the reason a `Notification` row can reach someone with no tab
/// open at all. `NotificationsService.announce` is the only writer of what
/// gets SENT; this table only says WHERE.
///
/// One row per subscribed browser, not per user — the same admin signed in on
/// a phone and a laptop holds two, and both get woken.
model PushSubscription {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id")
  /// The push service's own URL for this browser (`PushSubscription.endpoint`
  /// in the browser API) — opaque to this platform, and the natural dedup
  /// key: re-subscribing the same browser reliably returns the same one, so
  /// `PushService.subscribe` upserts on it rather than growing a duplicate
  /// row every time the toggle is clicked again.
  endpoint  String   @unique
  /// The two keys `PushSubscription.getKey()` returns, base64url-encoded —
  /// `web-push` needs both to encrypt a payload this browser can decrypt.
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "every subscription this admin has" — small (a handful of browsers per
  /// person), read once per notification fan-out.
  @@index([userId])
  @@map("push_subscriptions")
  @@schema("app")
}


enum NotificationKind {
  /// An attempt finished grading. Fires for an auto-graded paper at submit and
  /// for a `pending_review` one when the instructor finishes marking it —
  /// which is the case a student otherwise has no way to learn about.
  quiz_graded
  /// An admin deliberately granted a further sitting, usually after a
  /// technical failure. They were never told it was done.
  extra_attempt_granted
  /// المساعد — the instructor answered a conversation this student opened.
  /// The first kind that carries no lesson; see `NotificationsService.emit`.
  conversation_reply
  /// «رسايل م. أيمن» — he wrote FIRST. The only kind not caused by something
  /// the student did to the platform, which is exactly why it needs a
  /// notification: nothing else on screen would tell them a message is waiting.
  instructor_message
  /// An admin approved a `PaymentSubmission`. Carries `courseId` and the new
  /// `validUntil` — no lesson, same as `conversation_reply`.
  payment_approved
  /// An admin rejected a `PaymentSubmission`. Carries `courseId` and the
  /// admin's `reason`.
  payment_rejected
  /// A `purchase` `AccessGrant` is within `WARNING_WINDOW_MS` (3 days) of its
  /// `validUntil` — see `SubscriptionExpirySweeper`. Carries `courseId` and
  /// the grant's own `validUntil`, same shape as
  /// `payment_approved`. Fires at most once per grant per lapse: the sweeper
  /// dedupes on an existing notification of this kind for the same
  /// (userId, courseId, validUntil), so a renewal that pushes `validUntil`
  /// forward is a fresh triple and gets its own notice when IT next comes
  /// due, while a grant sitting unrenewed inside the window is not re-said
  /// every day the daily sweep runs over it.
  subscription_expiring_soon
  /// An admin cancelled a `purchase` `AccessGrant` early through
  /// `/admin/finance`, with `cancelReasonVisibleToStudent: true` — see the
  /// grant's own model note. Carries `courseId` and the admin's `reason`,
  /// same shape as `payment_rejected`. Only ever emitted when the admin
  /// chose to show it; the far more common silent cancellation (the toggle
  /// left off) writes no notification at all.
  subscription_cancelled
  /// ADMIN — a student uploaded a Vodafone Cash transfer and is waiting on a
  /// decision. The first kind addressed to staff; emitted one row per user
  /// holding `payment:read` at the moment of the submission.
  payment_submitted
  /// ADMIN — a book order is paid for and waiting to be shipped. Same shape of
  /// event as above, one permission over (`book-order:read`).
  book_order_placed
  /// ADMIN — a student sent المساعد a message that needs a reply, whether a
  /// new thread or a follow-up on one already answered. Same shape of event
  /// as the pair above, one permission over (`conversation:read`).
  assistant_question_received
  /// STUDENT — «الكتاب اتشحن». The first half of the answer to «طلبت الكتاب
  /// وبعدين إيه؟»: the platform knew the order shipped and told nobody, so the
  /// student's only way to find out was to ask. Carries `bookOrderId`.
  book_order_shipped
  /// STUDENT — «الكتاب وصلك». Sent when the admin confirms arrival, and worded
  /// to close the loop rather than to congratulate: it says the order is
  /// complete and where to go if it is not. Carries `bookOrderId`.
  book_order_delivered
  /// STUDENT — the order was turned down, with the admin's reason. Same shape
  /// and the same intent as `payment_rejected`: the student is told what
  /// happened and what to do, never left with an order that silently stopped
  /// moving. Carries `bookOrderId` and `reason`.
  book_order_rejected
  /// «مبروك، خلصت الكورس». Back to a STUDENT kind after the three admin ones
  /// — it sits last only because `ALTER TYPE … ADD VALUE` appends, and this
  /// list is kept in the DB's own order so a diff never reads as drift.
  ///
  /// Emitted by `CourseProgressService.recalculate` on the TRANSITION into
  /// finished and nowhere else: the enrolment's `completedAt` was null and
  /// this recalculation made it non-null. `finished` itself is recomputed on
  /// every lesson completion and stays true for as long as the course does not
  /// grow, so emitting on the VALUE rather than the EDGE would re-congratulate
  /// a student every time they re-opened a finished lesson to revise. Carries
  /// `courseId` only; the title and slug are resolved at read time, like every
  /// other course-carrying kind.
  course_completed

  @@map("notification_kind")
  @@schema("app")
}

/// Append-only, hash-chained. `prevHash` is the previous row's `hash`, so any
/// edit or deletion breaks verification from that point forward. INSERT-only
/// for ayman_runtime — the REVOKE lives in the migration.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  occurredAt     DateTime @default(now()) @map("occurred_at")
  actorUserId    String?  @map("actor_user_id")
  actorIp        String?  @map("actor_ip") @db.Inet
  actorUserAgent String?  @map("actor_user_agent")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  outcome        String
  metadata       Json?
  requestId      String?  @map("request_id")
  prevHash       String?  @map("prev_hash") @db.Char(64)
  hash           String   @db.Char(64)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_log")
  @@schema("app")
}

/// A failure a student actually saw, GROUPED rather than logged one row per
/// victim.
///
/// ## Why this table exists
///
/// `lib/report-error.ts` in the web app said it plainly: there is no client
/// error reporting in this repo — no Sentry, no RUM, no `onRequestError` — and
/// `console.error` was the entire sink, read only if someone happened to be
/// holding the device with devtools open. A Server Component throw at least
/// reached the container log; a client render error reached nothing at all.
/// So the instructor's only signal that anything was broken was a student
/// telling him, which is the situation this is here to end.
///
/// ## Grouped on `fingerprint`, and that is the whole design
///
/// One row per DISTINCT failure, with a counter — not one row per occurrence.
/// The failures this product has are outages: an API that is briefly
/// unreachable takes out every page view in that window, and a table that grew
/// per view would answer "how many students hit it" by being unreadable. What
/// the instructor needs to see on opening the page is a short list of DISTINCT
/// problems ordered by how recently they happened, each carrying how often and
/// since when. `occurrences` is that count; `firstSeenAt` is when it started.
///
/// The fingerprint is the digest when Next supplied one — it already hashes
/// message and stack, so two reports sharing it are the same fault — and a
/// hash of route + message otherwise, which is the best available grouping for
/// a client-side throw that carries no digest.
///
/// ## What is deliberately NOT stored
///
/// No IP, and no request body. The `userId` is nullable and is only filled when
/// the report arrives with a session, because a signed-out visitor hitting a
/// broken course page is exactly as worth knowing about. `userAgent` is kept
/// because "only on iOS Safari" is a diagnosis and nothing else here can say it.
model ErrorReport {
  id          BigInt    @id @default(autoincrement())
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  /// How many reports have collapsed into this row.
  occurrences Int       @default(1)
  /// The grouping key. See the note above for how it is derived.
  fingerprint String    @unique
  /// Next's own identifier, when the failure was a Server Component throw. It
  /// is what ties this row to the line in the container log.
  digest      String?
  /// `server` | `client` | `timeout` — see `ERROR_REPORT_KINDS` in contracts.
  kind        String
  /// The pathname the student was on. Never the full URL: a query string can
  /// carry a token.
  route       String
  message     String
  stack       String?
  userAgent   String?   @map("user_agent")
  userId      String?   @map("user_id")
  /// Set when the instructor marks it handled. Resolved rows drop off the
  /// default view but are never deleted — a fault that comes back is worth
  /// seeing as a fault that came back.
  resolvedAt  DateTime? @map("resolved_at")

  @@index([lastSeenAt])
  @@index([resolvedAt, lastSeenAt])
  @@map("error_report")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// المساعد — the guided assistant, and the conversations it escalates into.
// ─────────────────────────────────────────────────────────────────────────

/// One thread between a visitor and the instructor.
///
/// Opened only when the question tree runs out — the assistant answers the
/// common questions itself and nothing about walking it is stored, so this
/// table grows with escalations rather than with traffic.
model Conversation {
  id String @id @default(uuid(7)) @db.Uuid

  /// Who spoke first.
  ///
  /// Defaulted to `visitor`, which makes every row written before «رسايل م.
  /// أيمن» existed correct without touching one of them — the escalation path
  /// is the only thing that used to create a conversation.
  ///
  /// An `outreach` row is ALWAYS owned by a `userId`: the platform cannot write
  /// to a guest it has no account for, and the CHECK below still holds because
  /// the delivery path sets `user_id` and never `guest_token_hash`.
  origin ConversationOrigin @default(visitor)

  /// Set when a signed-in student opens the thread; NULL for a guest.
  /// Exactly one of `userId` and `guestTokenHash` is set — enforced by the
  /// CHECK in the migration, because a row with neither is unreachable by
  /// anyone and a row with both has two competing owners.
  userId String? @map("user_id")

  /// What a guest typed so the instructor can reach them. Never echoed back
  /// to the visitor side of the wire — see `conversation.ts`.
  guestName  String? @map("guest_name") @db.VarChar(120)
  guestPhone String? @map("guest_phone") @db.VarChar(20)

  /// SHA-256 of the opaque token in the `__Host-assistant` cookie, never the
  /// token itself. A dump of this table therefore hands out no read access:
  /// the hash cannot be replayed as a cookie. Same reasoning as storing a
  /// password verifier rather than a password.
  guestTokenHash String? @unique @map("guest_token_hash") @db.Char(64)

  /// The node ids the visitor walked to get here, e.g.
  /// `['root','join','joinPrice']`. IDS, not sentences — the inbox resolves
  /// them to Arabic at READ time, so re-wording a question does not leave
  /// every historical row quoting the old wording. Same discipline
  /// `NotificationsService` follows for lesson titles.
  entryPath String[] @map("entry_path")

  status ConversationStatus @default(open)

  /// Denormalised from the messages, maintained in the same transaction as
  /// the insert. The inbox orders by it on every load; deriving it would mean
  /// a correlated subquery over the message table for every row on the page.
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  /// Who spoke LAST. Denormalised on purpose — see the migration
  /// `20260905060000_conversation_last_message_author` for the whole argument.
  ///
  /// «غير مقروءة» means the OTHER side spoke, not "something happened": every
  /// message bumps `lastMessageAt`, his own «رسالة للطلبة» sends included, so
  /// the old rule put his own outbox back on his unread tab and counted it in
  /// the sidebar badge.
  ///
  /// ⚠️ Write it in the SAME transaction as `lastMessageAt`, at every call site
  /// that appends a message. A fourth writer that forgets makes the tab lie.
  lastMessageAuthor MessageAuthor @default(visitor) @map("last_message_author")

  /// When each side last read the thread. Nullable rather than boolean,
  /// matching every other soft-state column in this schema: it records WHEN,
  /// which a boolean throws away for no saving.
  adminReadAt   DateTime? @map("admin_read_at")
  visitorReadAt DateTime? @map("visitor_read_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// SetNull, NOT Cascade. A student deleting their account must not erase
  /// the instructor's side of a conversation he already spent time answering
  /// — and the guest columns keep the row reachable in the inbox afterwards.
  user     User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]
  outreach OutreachMessage[]

  /// The inbox's only ordering: a status filter, newest activity first.
  @@index([status, lastMessageAt(sort: Desc)])
  /// The «اللي بعتّه» tab, and the delivery path's find-or-create: one outreach
  /// thread per student, reused for every message the platform sends them.
  @@index([origin, lastMessageAt(sort: Desc)])
  /// "Has this student written before?" from their admin record.
  @@index([userId])
  @@map("conversations")
  @@schema("app")
}

/// Who opened the thread. See the field comment on `Conversation.origin`.
enum ConversationOrigin {
  visitor
  outreach

  @@map("conversation_origin")
  @@schema("app")
}

model ConversationMessage {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  author         MessageAuthor
  /// PLAIN TEXT. There is no HTML sink on either end of this column — not a
  /// sanitised-HTML field with the sanitiser omitted. Adding rich text here
  /// is the regression.
  body           String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")

  /// «ردّ بإيموجي» — one emoji the INSTRUCTOR put on this message, WhatsApp
  /// style, or NULL for none.
  ///
  /// ## Two columns would be the shape, and one is enough for now
  ///
  /// A reactions TABLE is what a group chat needs, because "who reacted" is a
  /// list. This conversation has exactly two participants, so a reaction is at
  /// most one emoji per side and a column each says it completely — no join,
  /// no `(message, actor)` unique index, no delete path. Only the admin's
  /// exists today because only he was asked for; a `visitor_reaction` beside
  /// it later is one nullable column and no migration of anything.
  ///
  /// ## Why a string and not an enum
  ///
  /// The set of offered emoji is a UI decision (`MESSAGE_REACTIONS` in the
  /// contract) and changes with taste; a Postgres enum would make «add 🔥 to
  /// the picker» a migration. The column is length-capped in the migration and
  /// the API validates against the offered set, so nothing arbitrary is
  /// stored — the value is constrained where the decision lives, not where the
  /// bytes do.
  adminReaction String? @map("admin_reaction") @db.VarChar(16)

  /// The file the INSTRUCTOR attached — `msg/<2 hex>/<uuid>.<ext>`.
  ///
  /// ## Three columns, and no `mime` among them
  ///
  /// The stored extension is picked by US from the detected type — sharp's
  /// output for an image, `EXT_FOR_MIME` for a document — so the key is the
  /// only statement of what the bytes are that an uploader could not have
  /// forged. `mimeForStorageKey` reads it back off the key; a fourth column
  /// holding the same fact could only ever drift from it.
  ///
  /// ## No foreign key to `media_assets`
  ///
  /// Because there is no row there. A conversation attachment is minted under
  /// its own `msg/` prefix with no library entry, exactly like a lesson
  /// document: the media library is the screen he picks course covers from,
  /// and a term of photographs sent to individual students does not belong in
  /// it. Nothing in this schema has an FK to `media_assets` either way.
  ///
  /// All three move together — a CHECK in the migration enforces that — and
  /// the body CHECK was widened at the same time, so a message may be a file
  /// with no caption.
  attachmentKey   String? @map("attachment_key")
  attachmentName  String? @map("attachment_name") @db.VarChar(200)
  attachmentBytes Int?    @map("attachment_bytes")

  /// How long a VOICE NOTE runs, in whole seconds. NULL for every other kind
  /// of attachment and for every message that has none.
  ///
  /// It cannot be read back off the bytes at render time: `MediaRecorder`
  /// writes a WebM stream live and puts no duration in its header, so
  /// `HTMLAudioElement.duration` reads `Infinity` until the file has been
  /// seeked through end to end. A player that cannot draw a progress bar until
  /// you have already heard the clip is not a player.
  ///
  /// So the number comes from the RECORDER, which counted. That is the
  /// instructor's own browser, the value is display-only, and being wrong costs
  /// a slightly wrong progress bar — cheaper than an ffprobe this image does
  /// not carry. CHECKed at ten minutes so a bad number cannot stretch a bubble
  /// across the thread.
  attachmentDurationSeconds Int? @map("attachment_duration_seconds")

  /// When the INSTRUCTOR last rewrote this message's text, or NULL for never —
  /// which is every message that was sent and left alone.
  ///
  /// The bubble renders «معدّلة» from it. Silently changing what somebody has
  /// already read is the one thing an edit must not do, and there is no history
  /// table behind it: the audit log records who edited what and when, and a
  /// second copy of every message would double the most-written table on the
  /// platform.
  editedAt DateTime? @map("edited_at")

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  outreach     OutreachMessage?

  /// The thread, in order, straight off the index with no sort.
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
  @@schema("app")
}

/// ═══════════════════════════════════════════════════════════════════════
/// «رسايل م. أيمن» — the messages the platform sends in the instructor's name.
/// ═══════════════════════════════════════════════════════════════════════
///
/// ## This is a LEDGER, not the message
///
/// The message itself is an ordinary `conversation_messages` row authored by
/// `admin`, in an ordinary conversation the student can answer — which is the
/// whole design: a student who replies is replying into the inbox he already
/// reads, and no second messaging system exists to keep in sync with the first.
///
/// This table records what that row was, and why:
///
///   · `variantKey` — which wording was used, so the NEXT message picks a
///     different one. This is the only durable memory the composer has, and
///     without it every student gets the same greeting forever.
///   · `facts` — the numbers the body was composed from, so `/admin/outreach`
///     can show him not just what was said but why it was said.
///   · `dedupeKey` — see the unique index below.
///
/// ## `facts` holds ids and numbers, and the BODY is on the message row
///
/// The apparent contradiction with Global Constraint 4 is argued in full in
/// `compose.ts`: a sent message is a record of a communication, and a record
/// that silently re-words itself when the copy pool is edited is not a record.
/// The pools still live in `packages/contracts/src/copy/outreach.ts`, so the
/// voice is edited in one place — what is frozen is only what was already said.
model OutreachMessage {
  id     String       @id @default(uuid(7)) @db.Uuid
  userId String       @map("user_id")
  kind   OutreachKind

  /// Idempotency. `attemptId` for a result, `quizId` for a nudge, the ISO week
  /// for a group invite — whatever makes "this exact message, again" nameable.
  ///
  /// Paired with `userId` and `kind` in a UNIQUE index, so a retried sweep, an
  /// overlapping cron tick, or a grading transaction replayed after a
  /// connection drop inserts nothing the second time. Idempotency lives in the
  /// DATABASE rather than in a "have I already?" SELECT, because the SELECT has
  /// a race and the index does not.
  dedupeKey String @map("dedupe_key")

  /// `g=2|o=4|s.weak=1`. Opaque here; parsed only by `compose.ts`.
  variantKey String @map("variant_key")

  /// Snapshot of what was true when it was sent. Never re-derived: the quiz
  /// title in here is the one the student was shown, even if the quiz is
  /// renamed afterwards.
  facts Json @default("{}")

  conversationId String @map("conversation_id") @db.Uuid
  /// One-to-one with the delivered message. UNIQUE, so this table can never
  /// claim two ledger rows for one thing the student read.
  messageId      String @unique @map("message_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// The idempotency guarantee. See `dedupeKey`.
  @@unique([userId, kind, dedupeKey])
  /// The composer's history read: this student's last few messages, newest
  /// first, across every kind — the greeting pool is shared, so the history
  /// has to be too.
  @@index([userId, createdAt(sort: Desc)])
  /// The `/admin/outreach` log, and the per-day cap the delivery path enforces.
  @@index([createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@map("outreach_messages")
  @@schema("app")
}

/// The four reasons the platform speaks first. Mirrors `OUTREACH_KINDS` in
/// `@ayman/contracts/outreach/kinds`, and `outreach.service.spec.ts` asserts
/// the two agree.
enum OutreachKind {
  quiz_result
  quiz_nudge
  lesson_praise
  whatsapp_invite

  @@map("outreach_kind")
  @@schema("app")
}

/// What a student typed into المساعد's open chat, and what came back.
///
/// ## This table reverses a decision, deliberately
///
/// The chat shipped storing NOTHING: no transcript, no log line. That was the
/// right default for a feature nobody had used, and the wrong one the moment
/// it started answering real questions — because the list of things students
/// asked and did not get a good answer to is the single most useful thing this
/// product could show the instructor. It was being thrown away.
///
/// ## What is deliberately NOT here
///
/// No name, no phone, no IP, no session, no guest token. A signed-in student
/// is a `user_id` and a visitor is nothing at all — the name on the admin
/// screen is JOINED at read time from the account, so deleting the account
/// deletes the identification without deleting the question.
///
/// ## Rows expire
///
/// Ninety days: long enough to see a pattern across a term, short enough that
/// a database dump is not a permanent record of what a fifteen-year-old typed
/// at midnight. `AssistantQuestionService` sweeps daily.
model AssistantQuestion {
  id String @id @default(uuid(7)) @db.Uuid

  /// NULL for a visitor who was never signed in. No other identifier is kept,
  /// so a NULL here is genuinely anonymous rather than pseudonymous.
  userId String? @map("user_id")

  /// Exactly what was typed, and exactly what was sent back.
  question String @db.Text
  answer   String @db.Text

  /// Which model answered — `gemini:…`, `groq:…` — or NULL when the written
  /// corpus did. The most useful column for reading the rest: a page of NULLs
  /// means the keys ran out, not that the answers are bad.
  provider String? @db.VarChar(120)

  /// المساعد said this one needed a person. Every `true` is a gap in the
  /// corpus with a student's own wording attached.
  escalated Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The admin list is newest-first and the sweeper deletes oldest-first —
  /// one index serves both.
  @@index([createdAt(sort: Desc)])
  /// «اللي المساعد وقف قدامه» is the actionable filter, and it is a small
  /// fraction of the rows, so it earns its own partial-shaped index.
  @@index([escalated, createdAt(sort: Desc)])
  @@map("assistant_questions")
  @@schema("app")
}

enum ConversationStatus {
  /// Waiting on the instructor.
  open
  /// He replied; the visitor may still follow up.
  answered
  /// Done. The visitor can start a new thread, not revive this one.
  closed

  @@map("conversation_status")
  @@schema("app")
}

enum MessageAuthor {
  visitor
  admin

  @@map("message_author")
  @@schema("app")
}

// ── التسويق: حملات واتساب ────────────────────────────────────────────────

enum CampaignStatus {
  /// Written, audience frozen, nothing sent. The only state that may be edited.
  draft
  /// The runner is draining it.
  running
  /// Stopped by a person. Resumable, and the counters survive.
  paused
  /// No pending recipients left.
  done
  /// Abandoned. Remaining recipients are marked `skipped`, never deleted —
  /// «مين اتبعتله» has to stay answerable after somebody changes their mind.
  cancelled

  @@map("campaign_status")
  @@schema("app")
}

enum CampaignRecipientStatus {
  pending
  sent
  /// Delivery was attempted and the device refused it. `error` says why.
  failed
  /// Never attempted: opted out, cancelled with the campaign, or the number
  /// turned out not to be on WhatsApp.
  skipped

  @@map("campaign_recipient_status")
  @@schema("app")
}

/// «حملة واتساب» — one message, one frozen list of numbers, drained slowly.
///
/// ## Why the pacing columns live on the ROW and not in settings
///
/// Because they are the campaign. «كل ٣٠ ثانية، ٢٠٠ في اليوم» is not a
/// platform preference that happens to apply — it is the difference between a
/// lecture announcement to a class and a blast that gets the instructor's
/// personal number banned, and a campaign started last week must keep the
/// numbers it was started with even if the defaults are changed today. A
/// global setting would silently re-pace every running campaign the moment
/// somebody edited it.
///
/// ## The three counters
///
/// `sentInBatch` / `sentToday` / `dayKey` are the whole of the runner's
/// memory. They are on the row rather than in Redis on purpose: a cache
/// eviction must not hand a campaign a fresh daily quota, which is the one
/// failure mode of this feature that cannot be undone.
model MarketingCampaign {
  id     String         @id @default(uuid(7)) @db.Uuid
  name   String         @db.VarChar(120)
  /// The template, with `{{الاسم}}` / `{{اللينك}}` still in it. Rendered per
  /// recipient at send time — never stored rendered, so a typo can be fixed
  /// in a paused campaign and every remaining message gets the fix.
  body   String
  status CampaignStatus @default(draft)

  /// Sent as a WhatsApp image message with the text as its caption.
  imageAssetId String? @map("image_asset_id") @db.Uuid
  linkUrl      String? @map("link_url")

  /// The resolved filter, kept for the audit trail and for the detail screen.
  /// NOT re-evaluated at send time — see `MarketingRecipient`.
  audience Json

  minDelaySeconds   Int @default(30) @map("min_delay_seconds")
  maxDelaySeconds   Int @default(90) @map("max_delay_seconds")
  batchSize         Int @default(30) @map("batch_size")
  batchPauseMinutes Int @default(10) @map("batch_pause_minutes")
  dailyCap          Int @default(200) @map("daily_cap")
  windowStartHour   Int @default(10) @map("window_start_hour")
  windowEndHour     Int @default(22) @map("window_end_hour")

  /// When the next message may go out. NULL while the campaign is not running.
  nextSendAt  DateTime? @map("next_send_at")
  sentInBatch Int       @default(0) @map("sent_in_batch")
  sentToday   Int       @default(0) @map("sent_today")
  /// Cairo calendar day `sentToday` counts, `YYYY-MM-DD`. A string rather
  /// than a `date` because the day is a CAIRO day and the column would
  /// otherwise be read as UTC by anything that touches it.
  dayKey      String?   @map("day_key") @db.VarChar(10)

  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  image      MediaAsset?           @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdBy  User?                 @relation("MarketingCampaignAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  recipients MarketingRecipient[]

  @@index([status, nextSendAt])
  @@index([createdAt(sort: Desc)])
  @@map("marketing_campaigns")
  @@schema("app")
}

/// One number in one campaign, and what happened to it.
///
/// Written when the campaign is created, which is what makes «فاضل كام» and
/// «وقف» mean anything. `position` fixes the order so a paused-and-resumed
/// campaign carries on where it stopped instead of re-picking arbitrarily.
///
/// `userId` is nullable and `phone` is not: a parent's number and a pasted
/// number have no account behind them, and the phone is the only thing every
/// row is guaranteed to have.
model MarketingRecipient {
  id         String                  @id @default(uuid(7)) @db.Uuid
  campaignId String                  @map("campaign_id") @db.Uuid
  /// E.164. Stored on the row rather than joined at send time so that editing
  /// a student's phone mid-campaign cannot redirect a queued message.
  phone      String                  @db.VarChar(20)
  /// Full name at queueing time, for `{{الاسم}}`. NULL for a pasted number.
  name       String?
  userId     String?                 @map("user_id")
  position   Int
  status     CampaignRecipientStatus @default(pending)
  attempts   Int                     @default(0)
  sentAt     DateTime?               @map("sent_at")
  /// Truncated device error, for the failures list. Never shown to a student.
  error      String?                 @db.VarChar(300)

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?             @relation("MarketingRecipientUser", fields: [userId], references: [id], onDelete: SetNull)

  /// The same number can be in two campaigns and never twice in one — a
  /// student who is also their own parent's contact would otherwise be
  /// messaged twice by one campaign.
  @@unique([campaignId, phone])
  /// The runner's only query: the next pending row of a running campaign.
  @@index([campaignId, status, position])
  @@map("marketing_recipients")
  @@schema("app")
}

/// «قف» — a number that must never be messaged again.
///
/// Global rather than per campaign, and consulted both when an audience is
/// resolved and again immediately before each send: a reply that arrives
/// mid-campaign has to stop the remaining messages, not just the next one.
///
/// The phone is the key because that is the only identifier an opt-out has —
/// the reply arrives on WhatsApp, from a number, possibly with no account
/// behind it at all.
model MarketingOptOut {
  phone     String   @id @db.VarChar(20)
  /// What the person actually sent, truncated. Kept because "did we honour
  /// it" is a question that gets asked after a complaint, not before.
  reason    String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("marketing_opt_outs")
  @@schema("app")
}
