# ── api origin (server-side only; never sent to the browser) ──────────
# apps/web's own server code (Server Components, Server Actions, proxy.ts)
# talks to the API directly at this origin. The BROWSER never sees it —
# next.config.ts's rewrite is what makes /api/* same-origin for the client.
API_ORIGIN="http://localhost:3300"

# ── media origin (PUBLIC — reaches the browser) ────────────────────────
# The third and last place an API host may appear in web code (Global
# Constraint 16), after next.config.ts and lib/api.ts. MUST be the SAME
# origin apps/api's MEDIA_BASE_URL serves media from — apps/api's env.ts
# asserts at boot that MEDIA_BASE_URL is a DIFFERENT origin than APP_URL,
# but it cannot see this value directly (two independently deployed
# processes), so keeping the two in sync is still this operator's job.
NEXT_PUBLIC_MEDIA_ORIGIN="http://localhost:3300"

# ── redis (OPTIONAL — where `'use cache'` entries are stored) ──────────
# Unset is a supported mode, not a broken one: the cache handler in
# cache-handler/redis.js falls back to an in-memory tier, which is exactly
# how `next build` runs (the Dockerfile passes only NEXT_PUBLIC_* as build
# args, so REDIS_URL is absent inside `docker build` by construction).
#
# Set it and the cache survives a restart, and `updateTag()` reaches every
# instance instead of only the one that served the admin's save. Redis being
# unreachable is never fatal here — unlike apps/api, which uses the SAME
# Redis for rate limiting and deliberately fails CLOSED. See
# docs/DEPLOYMENT.md §5.
REDIS_URL="redis://localhost:6379"
