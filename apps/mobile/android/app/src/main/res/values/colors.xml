<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The accent Android tints the small notification icon with: the `a-9`
      token in light mode (#EFA22C), from packages/ui/src/tokens/color.css.

      One value for both themes, because Android does not re-read this per
      theme and the amber clears contrast on both the light and dark
      notification shades.

      NOTE: the CSS spells that token with two leading dashes. It cannot be
      written that way here — XML forbids a double hyphen anywhere inside a
      comment, and aapt fails the whole resource merge with
      "The string is not permitted within comments".
    -->
    <color name="notification_accent">#EFA22C</color>
    <color name="ic_launcher_background">#F9F8F6</color>
</resources>
