    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@ayman/config": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "catalog:",
    "@types/react": "19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "9.39.5",
    "jsdom": "27.0.0",
    "react": "19.2.8",
    "typescript": "catalog:",
